---
import { getCollection } from "astro:content";
import Footer from "@components/layout/Footer/Footer.astro";
import Header from "@components/layout/Header/Header.astro";
import UrgentAlertBanner from "@components/data/display/UrgentAlertBanner/UrgentAlertBanner.astro";
import { defaultLang, ui, type TLang } from "@i18n/ui";
import {
  buildAlternateLangHref,
  getLangFromUrl,
  useTranslations,
} from "@i18n/utils";
import { Font } from "astro:assets";
import { getLocalizedMocks } from "@utils/data.mocks";

import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title: pageTitleProp, description: pageDescriptionProp }
  = Astro.props as Props;

const defaultSiteTitle = t("seo.default-title");
const pageTitle = pageTitleProp
  ? `${pageTitleProp} | ${defaultSiteTitle}`
  : defaultSiteTitle;
const pageDescription = pageDescriptionProp ?? t("seo.default-description");

const supportedLangs = Object.keys(ui) as Array<TLang>;
const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const canonicalUrl = new URL(
  buildAlternateLangHref(Astro.url, lang, lang),
  siteOrigin,
).href;
const alternateLinks = supportedLangs.map((targetLang) => ({
  hreflang: targetLang,
  href: new URL(
    buildAlternateLangHref(Astro.url, targetLang, lang),
    siteOrigin,
  ).href,
}));
const xDefaultHref = new URL(
  buildAlternateLangHref(Astro.url, defaultLang, lang),
  siteOrigin,
).href;

const localizedMocks = getLocalizedMocks(lang);
const globalSettingEntries = await getCollection(
  "globalSetting",
  (entry) => entry.data.locale === lang,
);
const globalSetting = globalSettingEntries[0]?.data;

const dir = localizedMocks.dir;
const contactInfo = globalSetting?.contactInfo ?? localizedMocks.contactInfo;
const fastLinks = globalSetting?.fastLinks ?? localizedMocks.fastLinks;
const lemma = globalSetting?.lemma ?? localizedMocks.lemma;
const navLinks = globalSetting?.navLinks ?? localizedMocks.navLinks;
const rightsText = globalSetting?.rightsText ?? localizedMocks.rightsText;
const socialNetworkLinks
  = globalSetting?.socialNetworkLinks ?? localizedMocks.socialNetworkLinks;
---

<!doctype html>
<!-- ﷽ - In the name of Allah, the Most Gracious, the Most Merciful -->
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={lang} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateLinks.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-symbols" preload />

    <script is:inline>
      function applyResolvedTheme(resolved) {
        document.documentElement.dataset.theme = resolved;
        document.documentElement.classList.toggle("dark", resolved === "dark");
      }

      function initTheme() {
        try {
          const stored =
            localStorage.getItem("colorTheme") || localStorage.getItem("theme");
          const setting =
            stored === "light" || stored === "dark" || stored === "system"
              ? stored
              : "system";

          const resolved =
            setting === "system"
              ? window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark"
              : setting;

          applyResolvedTheme(resolved);
          localStorage.setItem("colorTheme", setting);
          localStorage.setItem("theme", setting);

          const mql = window.matchMedia("(prefers-color-scheme: dark)");
          const handleSystemChange = () => {
            const current =
              localStorage.getItem("colorTheme") ||
              localStorage.getItem("theme");
            if (current !== "system") return;
            applyResolvedTheme(mql.matches ? "dark" : "light");
          };
          mql.addEventListener("change", handleSystemChange);
        } catch {
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          applyResolvedTheme(prefersDark ? "dark" : "light");
        }
      }

      initTheme();
      document.addEventListener("astro:after-swap", initTheme);
      document.addEventListener("theme:change", (e) => {
        const next = e?.detail?.theme;
        if (next === "dark" || next === "light") {
          applyResolvedTheme(next);
          try {
            localStorage.setItem("theme", next);
          } catch {}
        }
      });
    </script>
  </head>
  <body
    class="
      bg-background font-display text-slate-900 transition-colors duration-300
      dark:text-slate-100
    "
  >
    <UrgentAlertBanner lang={lang} />
    <Header lang={lang} navLinks={navLinks} />
    <main
      class="
        mx-auto my-20 flex max-w-7xl flex-col gap-20 px-4
        sm:px-6
        lg:px-8
      "
    >
      <slot />
    </main>
    <Footer
      lang={lang}
      lemma={lemma}
      contactInfo={contactInfo}
      rightsText={rightsText}
      socialNetworkLinks={socialNetworkLinks}
      fastLinks={fastLinks}
    />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
