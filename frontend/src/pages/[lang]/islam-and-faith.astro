---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import PageHeroBanner from "@components/data/display/PageHeroBanner/PageHeroBanner.astro";
import TiptapContent from "@components/data/display/TiptapContent/TiptapContent.astro";
import FivePillarsSection from "@components/data/display/FivePillarsSection/FivePillarsSection.astro";
import FaqAccordionSection from "@components/data/display/FaqAccordionSection/FaqAccordionSection.astro";
import AcademyCoursesSection from "@components/data/display/Academy/AcademyCoursesSection/AcademyCoursesSection.astro";
import MediaHighlightsSection from "@components/data/display/Media/MediaHighlightsSection/MediaHighlightsSection.astro";
import PublicationsAndGlossarySection from "@components/data/display/Resources/PublicationsAndGlossarySection/PublicationsAndGlossarySection.astro";
import ScriptureExplorerSection from "@components/data/display/ScriptureExplorerSection/ScriptureExplorerSection.astro";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "@i18n/utils";
import { ui, type TLang } from "@i18n/ui";
import { fetchStrapiData } from "@services/strapi";
import { getLocalizedMocks } from "@utils/data.mocks";
import {
  getLocalizedGlossaryTerms,
  getLocalizedPublications,
  type TResourceGlossaryTerm,
  type TResourcePublication,
} from "@utils/resources-mocks";
import type { TAcademyArticle } from "@utils/models/academy";
import type { TMediaHighlight } from "@utils/models/media";

export function getStaticPaths() {
  const langs = Object.keys(ui) as Array<TLang>;
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const localizedMocks = getLocalizedMocks(lang);
const fallbackPublications = getLocalizedPublications(lang);
const fallbackGlossaryTerms = getLocalizedGlossaryTerms(lang);

const [
  articleEntries,
  mediaEntries,
  faqEntries,
  islamFaithEntries,
  cmsPublicationsRes,
  cmsGlossaryRes,
] = await Promise.all([
  getCollection("articles", (entry) => entry.data.locale === lang),
  getCollection("mediaHighlights", (entry) => entry.data.locale === lang),
  getCollection("faqs", (entry) => entry.data.locale === lang),
  getCollection("islamFaithPage", (entry) => entry.data.locale === lang),
  fetchStrapiData<{ data?: TResourcePublication[] }>("resources/publications", {
    locale: lang,
  }).catch(() => null),
  fetchStrapiData<{ data?: TResourceGlossaryTerm[] }>("resources/glossary", {
    locale: lang,
  }).catch(() => null),
]);

const cmsPubs = cmsPublicationsRes?.data;
const digitalPublications: TResourcePublication[]
  = Array.isArray(cmsPubs) && cmsPubs.length > 0
    ? cmsPubs
    : fallbackPublications;

const glossaryTerms: TResourceGlossaryTerm[]
  = Array.isArray(cmsGlossaryRes?.data) && cmsGlossaryRes.data.length > 0
    ? cmsGlossaryRes.data
    : fallbackGlossaryTerms;

const islamFaithData: Omit<typeof localizedMocks.islamFaithData, "faqs"> & {
  introText?: string;
} = islamFaithEntries[0]?.data ?? localizedMocks.islamFaithData;

const academyCourses
  = articleEntries.length > 0
    ? articleEntries.map((entry) => entry.data)
    : localizedMocks.academyCourses;

const mediaHighlights: Array<TMediaHighlight>
  = mediaEntries.length > 0
    ? mediaEntries.map((entry) => ({
        title: entry.data.title,
        href: entry.data.href,
        imageUrl: entry.data.imageUrl,
        imageAlt: entry.data.imageAlt,
      }))
    : localizedMocks.mediaHighlights;

const faqs
  = faqEntries.length > 0
    ? faqEntries.map((entry) => entry.data)
    : localizedMocks.islamFaithData.faqs;
---

<Layout
  title={t("islam-page.title")}
  description={t("islam-page.subtitle")}
>
  <!-- Hero & Shahada Callout -->
  <PageHeroBanner
    badgeIcon="menu_book"
    badgeLabel={t("islam-page.badge")}
    title={t("islam-page.title")}
    subtitle={t("islam-page.subtitle")}
  >
    <div
      class="
        mx-auto mt-10 max-w-3xl rounded-2xl border border-white/15 bg-white/10
        p-6 backdrop-blur-sm
        sm:p-8
      "
    >
      <p
        class="
          text-2xl/relaxed font-bold text-amber-300
          sm:text-3xl
        "
        dir="rtl"
      >
        {islamFaithData.shahadaArabic}
      </p>
      <p class="mt-3 text-sm text-blue-100 italic">
        “
        {islamFaithData.shahadaTransliteration}
        ”
      </p>
      <p class="mt-2 text-sm font-semibold text-white">
        {islamFaithData.shahadaTranslation}
      </p>
    </div>
  </PageHeroBanner>

  {
    islamFaithData.introText && (
      <section class="
        rounded-2xl border border-slate-200 bg-white p-8 shadow-sm
        dark:border-slate-800 dark:bg-slate-900
      "
      >
        <TiptapContent content={islamFaithData.introText} />
      </section>
    )
  }

  <!-- Five Pillars of Islam -->
  <FivePillarsSection lang={lang} pillars={islamFaithData.fivePillars} />

  <!--
    Quran, Hadith, Daily Inspiration & Digital Tasbih
    (@vicacha-devs/strapi-plugin-islam)
  -->
  <ScriptureExplorerSection lang={lang} />

  <!-- Academy Courses & Articles -->
  <AcademyCoursesSection
    title={t("academy.home-title")}
    description={t("academy.home-description")}
    ctaLabel={t("academy.home-cta-label")}
    articleCtaLabel={t("academy.article-cta-label")}
    academyHref={translatePath("/islam-and-faith")}
    articles={academyCourses.map<TAcademyArticle>((course) => ({
      ...course,
      ctaLabel: t("academy.article-cta-label"),
    }))}
  />

  <!-- Media Highlights & Khutbahs -->
  <MediaHighlightsSection
    title={t("media-highlights.title")}
    description={t("media-highlights.description")}
    cardCtaLabel={t("media-highlights.cta-card")}
    ctaLabel={t("media-highlights.cta")}
    mediaHref={translatePath("/media")}
    highlights={mediaHighlights}
  />

  <!--
    Digital Library Publications & Islamic Glossary
    (@vicacha-devs/strapi-plugin-resources)
  -->
  <PublicationsAndGlossarySection
    lang={lang}
    publications={digitalPublications}
    glossaryTerms={glossaryTerms}
  />

  <!-- Frequently Asked Questions -->
  <FaqAccordionSection lang={lang} faqs={faqs} />
</Layout>
