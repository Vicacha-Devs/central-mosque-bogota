---
import { getCollection } from "astro:content";
import { Avatar, AvatarFallback } from "@/components/starwind/avatar";
import { Badge } from "@/components/starwind/badge";
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/components/starwind/breadcrumb";
import { Card, CardContent } from "@/components/starwind/card";
import { Separator } from "@/components/starwind/separator";
import Icon from "@components/data/display/Icons/Icon.astro";
import TiptapContent from "@components/data/display/TiptapContent/TiptapContent.astro";
import { ui, type TLang } from "@i18n/ui";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "@i18n/utils";
import Layout from "@layouts/Layout.astro";
import { getLocalizedAboutPageData } from "@utils/institutional-mocks";

interface StaffProfile {
  name: string;
  slug: string;
  honorificTitle?: string;
  roleTitle: string;
  memberCategory?: string;
  shortSummary?: string;
  bio: string;
  credentials?: string;
  officeHours?: string;
  languagesSpoken: string;
  showInStaffDirectory?: boolean;
  hasDedicatedPage?: boolean;
  isAuthor?: boolean;
  isKhateeb?: boolean;
}

export async function getStaticPaths() {
  const leaderEntries = await getCollection("leaders");
  if (leaderEntries.length > 0) {
    return leaderEntries
      .filter(
        (entry) => entry.data.hasDedicatedPage !== false && entry.data.slug,
      )
      .map((entry) => ({
        params: { lang: entry.data.locale, slug: entry.data.slug },
        props: { member: entry.data as StaffProfile },
      }));
  }

  const langs = Object.keys(ui) as Array<TLang>;
  const paths: Array<{
    params: { lang: TLang; slug: string };
    props: { member: StaffProfile };
  }> = [];

  for (const lang of langs) {
    const leaders = getLocalizedAboutPageData(lang).leaders;
    for (const member of leaders) {
      if (member.slug && member.hasDedicatedPage !== false) {
        paths.push({
          params: { lang, slug: member.slug },
          props: { member: { ...member, slug: member.slug } },
        });
      }
    }
  }

  return paths;
}

interface Props {
  member: StaffProfile;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { member } = Astro.props as Props;

const [allArticles, allMedia, allEvents, allLeaders] = await Promise.all([
  getCollection("articles", (entry) => entry.data.locale === lang),
  getCollection("mediaHighlights", (entry) => entry.data.locale === lang),
  getCollection("events", (entry) => entry.data.locale === lang),
  getCollection("leaders", (entry) => entry.data.locale === lang),
]);

const matchesMember = (
  targetSlug: string | undefined,
  targetName: string | undefined
): boolean => {
  if (targetSlug && targetSlug === member.slug) return true;
  if (!targetName) return false;
  const normalizedTarget = targetName.toLowerCase();
  const normalizedMember = member.name.toLowerCase();
  return (
    normalizedTarget === normalizedMember
    || normalizedTarget.includes(normalizedMember)
    || normalizedMember.includes(normalizedTarget)
  );
};

const authoredArticles = allArticles
  .map((entry) => entry.data)
  .filter((a) => matchesMember(a.authorSlug, a.authorName));

const deliveredMedia = allMedia
  .map((entry) => entry.data)
  .filter((m) => matchesMember(m.speakerSlug, m.speakerName));

const ledEvents = allEvents
  .map((entry) => entry.data)
  .filter((e) => matchesMember(e.speakerSlug, e.speaker));

const otherStaff = (
  allLeaders.length > 0
    ? allLeaders.map((entry) => entry.data as StaffProfile)
    : getLocalizedAboutPageData(lang).leaders
).filter(
  (item) =>
    item.slug !== member.slug
    && item.showInStaffDirectory !== false
    && item.hasDedicatedPage !== false
);

const categoryIcon
  = member.memberCategory === "imam_scholar"
    ? "mosque"
    : member.memberCategory === "instructor"
      ? "school"
      : member.memberCategory === "staff_caretaker"
        ? "verified_user"
        : "person";

const labelsByLang: Record<
  TLang,
  {
    biographyTitle: string;
    credentialsTitle: string;
    officeHoursTitle: string;
    authoredArticlesTitle: string;
    deliveredMediaTitle: string;
    ledEventsTitle: string;
    otherStaffTitle: string;
  }
> = {
  es: {
    biographyTitle: "Biografía y Servicio en la Mezquita",
    credentialsTitle: "Formación Académica y Credenciales",
    officeHoursTitle: "Horario de Atención y Consejería",
    authoredArticlesTitle: "Artículos y Cursos Publicados",
    deliveredMediaTitle: "Jutbas, Conferencias y Multimedia",
    ledEventsTitle: "Clases y Actividades Dirigidas",
    otherStaffTitle: "Otros Miembros del Equipo y Liderazgo",
  },
  en: {
    biographyTitle: "Biography & Mosque Service",
    credentialsTitle: "Academic Credentials & Certifications",
    officeHoursTitle: "Office Hours & Counseling",
    authoredArticlesTitle: "Published Articles & Courses",
    deliveredMediaTitle: "Khutbahs, Lectures & Media",
    ledEventsTitle: "Classes & Mosque Events Led",
    otherStaffTitle: "Other Mosque Leadership & Staff",
  },
  ar: {
    biographyTitle: "السيرة الذاتية والخدمة في المسجد",
    credentialsTitle: "المؤهلات العلمية والإجازات",
    officeHoursTitle: "أوقات التواجد والإرشاد",
    authoredArticlesTitle: "المقالات والدورات العلمية المنشورة",
    deliveredMediaTitle: "الخطب والمحاضرات والمرئيات",
    ledEventsTitle: "الدروس والأنشطة التي يشرف عليها",
    otherStaffTitle: "أعضاء آخرون من إدارة وأئمة المسجد",
  },
  tr: {
    biographyTitle: "Biyografi ve Cami Hizmeti",
    credentialsTitle: "Akademik Eğitim ve İcazetler",
    officeHoursTitle: "Görüşme ve Danışmanlık Saatleri",
    authoredArticlesTitle: "Yayınlanan Makaleler ve Kurslar",
    deliveredMediaTitle: "Hutbeler, Sohbetler ve Medya",
    ledEventsTitle: "Yönetilen Dersler ve Etkinlikler",
    otherStaffTitle: "Diğer Cami Görevlileri ve Yönetim",
  },
};

const labels = labelsByLang[lang];
---

<Layout
  title={`${member.name} — ${member.roleTitle}`}
  description={member.shortSummary || member.bio}
>
  <div class="space-y-12">
    <!-- Breadcrumb -->
    <Breadcrumb>
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink
            href={translatePath("/about-us")}
            class="
              inline-flex items-center gap-2 font-semibold text-secondary
              hover:text-primary
              dark:text-blue-300
            "
          >
            <Icon name="arrow_back" class="text-base" />
            <span>{t("about-page.leadership-title")}</span>
          </BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage class="font-bold">{member.name}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>

    <!-- Staff Member Hero Card -->
    <Card
      class="
        overflow-hidden rounded-3xl border border-slate-200 bg-white p-0
        shadow-lg
        dark:border-slate-800 dark:bg-slate-900
      "
    >
      <CardContent class="
        p-8
        sm:p-12
      "
      >
        <div class="
          grid grid-cols-1 gap-8
          lg:grid-cols-12 lg:items-center
        "
        >
          <div class="
            flex flex-col items-start gap-6
            sm:flex-row sm:items-center
            lg:col-span-8
          "
          >
            <Avatar size="lg" variant="secondary" class="size-24 shrink-0">
              <AvatarFallback
                class="bg-secondary text-4xl font-bold text-white"
              >
                <Icon name={categoryIcon} class="text-4xl" />
              </AvatarFallback>
            </Avatar>

            <div class="space-y-3">
              {
                member.honorificTitle && (
                  <Badge
                    variant="primary"
                    class="
                      rounded-full bg-primary/15 px-3.5 py-1 text-xs font-bold
                      text-primary
                    "
                  >
                    {member.honorificTitle}
                  </Badge>
                )
              }
              <h1
                class="
                  text-3xl font-extrabold tracking-tight text-slate-900
                  sm:text-4xl
                  dark:text-white
                "
              >
                {member.name}
              </h1>
              <p class="text-lg font-bold text-primary">{member.roleTitle}</p>
              <div
                class="
                  flex flex-wrap items-center gap-4 pt-1 text-sm font-medium
                  text-slate-600
                  dark:text-slate-400
                "
              >
                <span class="inline-flex items-center gap-1.5">
                  <Icon name="translate" class="text-base text-secondary" />
                  <span>
                    {t("about-page.languages-label")}
                    :
                    {member.languagesSpoken}
                  </span>
                </span>
              </div>
            </div>
          </div>

          <div
            class="
              space-y-4 rounded-2xl border border-slate-100 bg-slate-50 p-6
              lg:col-span-4
              dark:border-slate-800 dark:bg-slate-800/50
            "
          >
            {
              member.credentials && (
                <div>
                  <p
                    class="
                      text-xs font-extrabold tracking-wider text-slate-400
                      uppercase
                    "
                  >
                    {labels.credentialsTitle}
                  </p>
                  <p
                    class="
                      mt-1 text-sm/relaxed font-medium text-slate-700
                      dark:text-slate-200
                    "
                  >
                    {member.credentials}
                  </p>
                </div>
              )
            }
            {
              member.officeHours && (
                <div>
                  <Separator class="
                    my-3 bg-slate-200
                    dark:bg-slate-700
                  "
                  />
                  <p
                    class="
                      text-xs font-extrabold tracking-wider text-slate-400
                      uppercase
                    "
                  >
                    {labels.officeHoursTitle}
                  </p>
                  <p
                    class="
                      mt-1 inline-flex items-center gap-1.5 text-sm
                      font-semibold text-slate-800
                      dark:text-slate-200
                    "
                  >
                    <Icon name="schedule" class="text-base text-primary" />
                    <span>{member.officeHours}</span>
                  </p>
                </div>
              )
            }
          </div>
        </div>

        <Separator class="
          my-8 bg-slate-100
          dark:bg-slate-800
        "
        />

        <!-- Full Biography -->
        <div class="space-y-4">
          <h2 class="
            text-2xl font-bold text-slate-900
            dark:text-white
          "
          >
            {labels.biographyTitle}
          </h2>
          <div
            class="
              max-w-none text-base/relaxed text-slate-600
              dark:text-slate-300
            "
          >
            <TiptapContent content={member.bio} />
          </div>
        </div>
      </CardContent>
    </Card>

    <!-- Authored Articles & Courses -->
    {
      authoredArticles.length > 0 && (
        <section class="space-y-6">
          <div class="flex items-center gap-3">
            <Icon name="menu_book" class="text-2xl text-primary" />
            <h2
              class="
                text-2xl font-extrabold text-slate-900
                dark:text-white
              "
            >
              {labels.authoredArticlesTitle}
            </h2>
          </div>

          <div
            class="
              grid grid-cols-1 gap-6
              md:grid-cols-2
              lg:grid-cols-3
            "
          >
            {authoredArticles.map((article) => (
              <Card
                class="
                  flex flex-col justify-between rounded-2xl border
                  border-slate-200 bg-white p-0 shadow-sm transition-shadow
                  hover:shadow-md
                  dark:border-slate-800 dark:bg-slate-900
                "
              >
                <CardContent class="flex h-full flex-col justify-between p-6">
                  <div class="space-y-3">
                    <Badge
                      variant="secondary"
                      class="rounded-full px-3 py-0.5 text-xs font-bold"
                    >
                      {article.badgeLabel}
                    </Badge>
                    <h3
                      class="
                        text-lg font-bold text-slate-900
                        dark:text-white
                      "
                    >
                      <a
                        href={article.href}
                        class="
                          transition-colors
                          hover:text-primary
                        "
                      >
                        {article.title}
                      </a>
                    </h3>
                    <p
                      class="
                        line-clamp-3 text-sm/relaxed text-slate-600
                        dark:text-slate-400
                      "
                    >
                      {article.description}
                    </p>
                  </div>
                  <div
                    class="
                      mt-6 flex items-center justify-between pt-4 text-xs
                      font-semibold text-slate-500
                    "
                  >
                    <span>
                      {article.readingTimeMinutes}
                      {" "}
                      {t("article-detail.reading-time")}
                    </span>
                    <a
                      href={article.href}
                      class="
                        inline-flex items-center gap-1 font-bold text-secondary
                        hover:text-primary
                        dark:text-blue-300
                      "
                    >
                      <Icon name="arrow_forward" class="text-sm" />
                    </a>
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        </section>
      )
    }

    <!-- Delivered Khutbahs, Lectures & Media -->
    {
      deliveredMedia.length > 0 && (
        <section class="space-y-6">
          <div class="flex items-center gap-3">
            <Icon name="podcasts" class="text-2xl text-secondary" />
            <h2
              class="
                text-2xl font-extrabold text-slate-900
                dark:text-white
              "
            >
              {labels.deliveredMediaTitle}
            </h2>
          </div>

          <div
            class="
              grid grid-cols-1 gap-6
              md:grid-cols-2
              lg:grid-cols-3
            "
          >
            {deliveredMedia.map((item) => (
              <Card
                class="
                  flex flex-col justify-between rounded-2xl border
                  border-slate-200 bg-white p-0 shadow-sm
                  dark:border-slate-800 dark:bg-slate-900
                "
              >
                <CardContent class="flex h-full flex-col justify-between p-6">
                  <div class="space-y-3">
                    <div class="flex items-center justify-between gap-2">
                      <Badge
                        variant="outline"
                        class="rounded-full px-3 py-0.5 text-xs font-bold"
                      >
                        {item.typeLabel}
                      </Badge>
                      <span class="text-xs font-medium text-slate-400">
                        {item.duration}
                      </span>
                    </div>
                    <h3
                      class="
                        text-lg font-bold text-slate-900
                        dark:text-white
                      "
                    >
                      <a
                        href={translatePath("/media")}
                        class="
                          transition-colors
                          hover:text-primary
                        "
                      >
                        {item.title}
                      </a>
                    </h3>
                    <p
                      class="
                        line-clamp-3 text-sm/relaxed text-slate-600
                        dark:text-slate-400
                      "
                    >
                      {item.description}
                    </p>
                  </div>
                  <div
                    class="
                      mt-6 flex items-center justify-between pt-4 text-xs
                      font-medium text-slate-500
                    "
                  >
                    <span>{item.publishedDate}</span>
                    <a
                      href={translatePath("/media")}
                      class="
                        inline-flex items-center gap-1 font-bold text-secondary
                        hover:text-primary
                        dark:text-blue-300
                      "
                    >
                      <Icon name="play_circle" class="text-base" />
                    </a>
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        </section>
      )
    }

    <!-- Classes & Events Led -->
    {
      ledEvents.length > 0 && (
        <section class="space-y-6">
          <div class="flex items-center gap-3">
            <Icon name="event" class="text-2xl text-primary" />
            <h2
              class="
                text-2xl font-extrabold text-slate-900
                dark:text-white
              "
            >
              {labels.ledEventsTitle}
            </h2>
          </div>

          <div
            class="
              grid grid-cols-1 gap-6
              md:grid-cols-2
              lg:grid-cols-3
            "
          >
            {ledEvents.map((ev) => (
              <Card
                class="
                  flex flex-col justify-between rounded-2xl border
                  border-slate-200 bg-white p-0 shadow-sm
                  dark:border-slate-800 dark:bg-slate-900
                "
              >
                <CardContent class="flex h-full flex-col justify-between p-6">
                  <div class="space-y-3">
                    <span class="text-xs font-bold text-primary uppercase">
                      {ev.schedule}
                    </span>
                    <h3
                      class="
                        text-lg font-bold text-slate-900
                        dark:text-white
                      "
                    >
                      <a
                        href={ev.url}
                        class="
                          transition-colors
                          hover:text-primary
                        "
                      >
                        {ev.title}
                      </a>
                    </h3>
                    <p
                      class="
                        line-clamp-2 text-sm/relaxed text-slate-600
                        dark:text-slate-400
                      "
                    >
                      {ev.description}
                    </p>
                  </div>
                  <div
                    class="
                      mt-4 flex items-center justify-between pt-3 text-xs
                      text-slate-500
                    "
                  >
                    <span>{ev.location}</span>
                    <a
                      href={ev.url}
                      class="
                        inline-flex items-center gap-1 font-bold text-secondary
                        hover:text-primary
                        dark:text-blue-300
                      "
                    >
                      <Icon name="arrow_forward" class="text-sm" />
                    </a>
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        </section>
      )
    }

    <!-- Other Mosque Staff & Leadership -->
    {
      otherStaff.length > 0 && (
        <section class="space-y-6 pt-4">
          <h2
            class="
              text-2xl font-extrabold text-slate-900
              dark:text-white
            "
          >
            {labels.otherStaffTitle}
          </h2>
          <div
            class="
              grid grid-cols-1 gap-6
              md:grid-cols-3
            "
          >
            {otherStaff.map((other) => (
              <Card
                class="
                  rounded-2xl border border-slate-200 bg-white p-0 shadow-sm
                  dark:border-slate-800 dark:bg-slate-900
                "
              >
                <CardContent class="p-6">
                  <h3
                    class="
                      text-lg font-bold text-slate-900
                      dark:text-white
                    "
                  >
                    <a
                      href={translatePath(`/staff/${other.slug}`)}
                      class="
                        transition-colors
                        hover:text-primary
                      "
                    >
                      {other.name}
                    </a>
                  </h3>
                  <p class="mt-1 text-xs font-semibold text-primary">
                    {other.roleTitle}
                  </p>
                  <p
                    class="
                      mt-3 line-clamp-2 text-xs/relaxed text-slate-600
                      dark:text-slate-400
                    "
                  >
                    {other.shortSummary || other.bio}
                  </p>
                </CardContent>
              </Card>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>
