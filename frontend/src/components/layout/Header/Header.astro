---
import { Button } from "@/components/starwind/button";
import {
  Sheet,
  SheetContent,
  SheetFooter,
  SheetTrigger,
} from "@/components/starwind/sheet";
import { ThemeToggle } from "@/components/starwind/theme-toggle";
import Icon from "@components/data/display/Icons/Icon.astro";
import type { TLang } from "@i18n/ui";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "@i18n/utils";
import LanguagePicker from "@components/navigation/LanguagePicker/LanguagePicker.astro";
import Link from "@components/actions/Link/Link.astro";
import type { TNavLink } from "@utils/models/types";

/**
 * @component Header
 * @title Header
 * @description Fixed top navigation header with branding, desktop nav links, language/theme controls, a donate CTA, and a mobile sheet menu.
 *
 * Props
 * - `lang`: optional locale override (`es`, `en`, `ar`, `tr`)
 * - `navLinks`: list of navigation links rendered in the desktop nav and mobile sheet
 *
 * i18n (used)
 * - `header.donate-now`
 *
 * @preview
 *
 * <Header
 *   navLinks={[
 *     { label: "Inicio", href: "/" },
 *     { label: "Eventos", href: "/events" },
 *     { label: "Donar", href: "/donate" },
 *   ]}
 * />
 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import Header from "@components/layout/Header.astro";
 * import type { TNavLink } from "@utils/types";
 *
 * const navLinks: Array<TNavLink> = [
 *   { label: "Inicio", href: "/" },
 *   { label: "Eventos", href: "/events" },
 * ];
 * ---
 *
 * <Header navLinks={navLinks} />
 * ```
 */
interface Props {
  /**
   * Optional locale override (`es`, `en`, `ar`, `tr`).
   */
  lang?: TLang;
  /**
   * Optional list of navigation links.
   */
  navLinks: Array<TNavLink>;
}

const { lang: langProp, navLinks } = Astro.props as Props;

const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const translatePath = useTranslatedPath(lang);
---

<header class="fixed inset-x-0 top-0 z-50 bg-secondary shadow-lg">
  <div
    class="
      mx-auto flex h-20 max-w-7xl items-center justify-between px-4 text-white
      sm:px-6
      lg:px-8
    "
  >
    <!-- Mosque branding -->
    <a href={translatePath("/")} class="flex items-center gap-3">
      <div class="rounded-full bg-white px-3 py-1.5">
        <Icon name="mosque" class="text-3xl text-secondary" />
      </div>
      <div>
        <span class="block text-xl/tight font-bold tracking-tight">
          {t("brand.title")}
        </span>
        <span class="text-xs tracking-widest uppercase opacity-80">
          {t("brand.subtitle")}
        </span>
      </div>
    </a>
    <!-- Main links -->
    <nav
      class="
        hidden items-center gap-5 text-[13px] font-semibold text-white/90
        lg:flex
        xl:gap-8 xl:text-sm
      "
    >
      {
        navLinks.map(({ label, href }) => (
          <Link href={translatePath(href)} color="navbar">
            {label}
          </Link>
        ))
      }
    </nav>
    <!-- Quick links -->
    <section class="
      hidden items-center gap-2
      lg:flex
      xl:gap-4
    "
    >
      <a
        href={translatePath("/search")}
        aria-label={t("header.search")}
        class="
          inline-flex size-9 items-center justify-center rounded-full
          bg-white/10 text-white transition-colors
          hover:bg-white/20
        "
      >
        <Icon name="search" class="text-lg" />
      </a>
      <LanguagePicker lang={lang} align="end" />
      <ThemeToggle
        ariaLabel={t("theme-switcher.system-label")}
        class="
          rounded-full border-white/20 bg-white/10 text-white
          hover:border-white/40 hover:bg-white/20 hover:text-white
          data-[state=on]:text-white
        "
      >
        <Icon
          slot="light-icon"
          name="light_mode"
          size="md"
          class="
            hidden size-5
            group-data-[state=off]:data-ready:inline-flex
          "
          data-theme-icon
        />
        <Icon
          slot="dark-icon"
          name="dark_mode"
          size="md"
          class="
            hidden size-5
            group-data-[state=on]:data-ready:inline-flex
          "
          data-theme-icon
        />
      </ThemeToggle>
      <Button
        variant="primary"
        class="
          transform rounded-full shadow-md transition-all
          hover:scale-105
        "
        href={translatePath("/donate")}
      >
        {t("header.donate-now")}
      </Button>
    </section>
    <!-- Mobile menu -->
    <Sheet class="lg:hidden">
      <SheetTrigger>
        <Icon name="menu" />
      </SheetTrigger>
      <SheetContent
        class="
          **:data-dialog-close:top-7 **:data-dialog-close:right-4
          **:data-dialog-close:sm:right-6
          **:data-dialog-close:lg:right-8
        "
      >
        <!-- Main links -->
        <nav
          class="
            mt-20 flex flex-col gap-5 p-4 text-[13px] font-semibold
            text-white/90
            xl:gap-8 xl:text-sm
          "
        >
          {
            navLinks.map(({ label, href }) => (
              <Link
                href={translatePath(href)}
                color="navbar"
                class="text-foreground"
              >
                {label}
              </Link>
            ))
          }
        </nav>
        <!-- Quick links -->
        <SheetFooter
          class="
            flex-row flex-wrap items-center gap-2
            xl:gap-4
          "
        >
          <a
            href={translatePath("/search")}
            aria-label={t("header.search")}
            class="
              inline-flex size-9 items-center justify-center rounded-full
              bg-slate-200 text-slate-800 transition-colors
              hover:bg-slate-300
              dark:bg-slate-800 dark:text-slate-100
            "
          >
            <Icon name="search" class="text-lg" />
          </a>
          <LanguagePicker lang={lang} align="center" />
          <ThemeToggle
            ariaLabel={t("theme-switcher.system-label")}
            class="rounded-full"
          >
            <Icon
              slot="light-icon"
              name="light_mode"
              size="md"
              class="
                hidden size-5
                group-data-[state=off]:data-ready:inline-flex
              "
              data-theme-icon
            />
            <Icon
              slot="dark-icon"
              name="dark_mode"
              size="md"
              class="
                hidden size-5
                group-data-[state=on]:data-ready:inline-flex
              "
              data-theme-icon
            />
          </ThemeToggle>
          <Button
            variant="primary"
            class="
              transform rounded-full shadow-md transition-all
              hover:scale-105
            "
            href={translatePath("/donate")}
          >
            {t("header.donate-now")}
          </Button>
        </SheetFooter>
      </SheetContent>
    </Sheet>
  </div>
</header>
