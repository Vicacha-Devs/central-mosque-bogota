---
import type { HTMLAttributes } from "astro/types";

import { dropdownSub } from "./variants";

type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<div
  class={dropdownSub({ class: className })}
  {...rest}
  data-slot="dropdown-sub"
>
  <slot />
</div>
