---
import type { HTMLAttributes } from "astro/types";

import { dialogClose } from "./variants";

type Props = HTMLAttributes<"button"> & {
  /**
   * When true, the component will render its child element instead of a button
   */
  asChild?: boolean;
};

const { class: className, asChild = false, ...rest } = Astro.props;

// Get the first child element if asChild is true
let hasChildren = false;
if (Astro.slots.has("default")) {
  hasChildren = true;
}
---

{
  asChild && hasChildren
    ? (
        <div class={dialogClose()} data-slot="dialog-close" data-as-child>
          <slot />
        </div>
      )
    : (
        <button
          type="button"
          class={dialogClose({ class: className })}
          {...rest}
          data-slot="dialog-close"
        >
          <slot>Demo close button</slot>
        </button>
      )
}
