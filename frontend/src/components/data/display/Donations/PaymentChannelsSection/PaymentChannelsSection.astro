---
import { Card, CardContent } from "@/components/starwind/card";
import Icon from "@components/data/display/Icons/Icon.astro";
import type { TLang } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";
import {
  getLocalizedPaymentMethods,
  type TPaymentMethod,
} from "@utils/institutional-mocks";

interface Props {
  lang?: TLang;
  methods?: TPaymentMethod[];
}

const {
  lang = "es",
  methods = getLocalizedPaymentMethods(lang),
} = Astro.props;
const t = useTranslations(lang);
---

<section class="space-y-8">
  <div class="text-center">
    <h2 class="
      text-3xl font-extrabold text-slate-900
      dark:text-white
    "
    >
      {t("donate-page.channelsTitle")}
    </h2>
    <p class="
      mt-2 text-slate-600
      dark:text-slate-400
    "
    >
      {t("donate-page.channelsSub")}
    </p>
  </div>

  <div class="
    grid grid-cols-1 gap-8
    md:grid-cols-3
  "
  >
    {
      methods.map((method) => (
        <Card class="
          rounded-2xl border border-slate-200 bg-white shadow-sm
          dark:border-slate-800 dark:bg-slate-900
        "
        >
          <CardContent class="p-6">
            <div class="
              mb-4 inline-flex size-12 items-center justify-center rounded-xl
              bg-secondary/10 text-secondary
              dark:bg-blue-500/20 dark:text-blue-300
            "
            >
              <Icon name="account_balance" class="text-2xl" />
            </div>
            <h3 class="
              text-xl font-bold text-slate-900
              dark:text-white
            "
            >
              {method.providerName}
            </h3>
            <p class="mt-1 text-sm font-semibold text-primary">
              {method.accountType}
              :
              {method.accountNumber}
            </p>
            <p class="
              mt-1 text-xs font-medium text-slate-500
              dark:text-slate-400
            "
            >
              {t("donate-page.holderLabel")}
              :
              {method.accountHolder}
              {" "}
              (
              {method.nit}
              )
            </p>
            <p class="
              mt-4 text-sm/relaxed text-slate-600
              dark:text-slate-400
            "
            >
              {method.instructions}
            </p>
          </CardContent>
        </Card>
      ))
    }
  </div>
</section>
