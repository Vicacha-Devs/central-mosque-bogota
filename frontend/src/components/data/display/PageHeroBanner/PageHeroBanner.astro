---
import { Badge } from "@/components/starwind/badge";
import Icon from "@components/data/display/Icons/Icon.astro";

interface Props {
  badgeIcon: string;
  badgeLabel: string;
  title: string;
  subtitle: string;
}

const { badgeIcon, badgeLabel, title, subtitle } = Astro.props;
---

<section
  class="
    relative overflow-hidden rounded-3xl bg-secondary px-6 py-16 text-center
    text-white shadow-xl
    sm:px-12
  "
  data-testid="page-hero-banner"
>
  <div class="relative z-10 mx-auto max-w-3xl text-center">
    <Badge
      variant="outline"
      class="
        mb-4 gap-2 rounded-full border-0 bg-white/10 px-4 py-1.5 text-xs
        font-bold tracking-widest text-white uppercase
      "
    >
      <Icon name={badgeIcon} class="text-sm" />
      <span>{badgeLabel}</span>
    </Badge>
    <h1 class="
      mb-4 text-3xl font-extrabold tracking-tight
      sm:text-5xl
    "
    >
      {title}
    </h1>
    <p class="
      mx-auto max-w-2xl text-base/relaxed text-blue-100/90
      sm:text-lg
    "
    >
      {subtitle}
    </p>
    <slot />
  </div>
</section>
