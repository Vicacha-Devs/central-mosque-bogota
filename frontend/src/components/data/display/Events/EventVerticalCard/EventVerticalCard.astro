---
import { Badge } from "@/components/starwind/badge";
import { Card, CardContent, CardFooter } from "@/components/starwind/card";
import { Separator } from "@/components/starwind/separator";
import Link from "@components/actions/Link/Link.astro";
import Icon from "@components/data/display/Icons/Icon.astro";
import type { TLang } from "@i18n/ui";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import type { TEvent } from "@utils/models/events";
import { Image } from "astro:assets";

/**
 * @component EventVerticalCard
 * @title Event Vertical Card
 * @description Displays an upcoming mosque event card with cover image, category badge, date badge, title, description, schedule footer, and details link.
 *
 * Props
 * - Extends `Omit<TEvent, "location">` (`category`, `title`, `description`, `schedule`, `date`, `image`, `url`)
 *
 * @preview
 *
 * <div class="max-w-sm">
 *   <EventVerticalCard {...event} />
 * </div>
 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import EventVerticalCard from "@components/data/display/Events/EventVerticalCard/EventVerticalCard.astro";
 * ---
 *
 * <EventVerticalCard {...event} />
 * ```
 */
interface Props extends Omit<TEvent, "location"> {
  lang?: TLang;
}

const {
  lang: langProp,
  category,
  title,
  description,
  schedule,
  date,
  image,
  url,
} = Astro.props as Props;

const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Card
  class="
    group gap-0 overflow-hidden rounded-xl border-secondary/5 bg-white py-0
    shadow-sm transition-all
    hover:shadow-xl
    dark:bg-slate-900
  "
>
  <div class="relative h-56 overflow-hidden">
    <Image
      width={512}
      height={512}
      class="
        size-full object-cover transition-transform duration-500
        group-hover:scale-105
      "
      layout="constrained"
      data-alt={title}
      alt={title}
      src={image}
    />
    <div
      class="
        absolute top-4 right-4 flex min-w-[60px] flex-col items-center
        rounded-lg bg-primary p-3 text-white shadow-lg
      "
    >
      <span class="text-xs font-bold tracking-tighter uppercase">
        {date.month}
      </span>
      <span class="text-2xl font-black">{date.day}</span>
    </div>
  </div>
  <CardContent class="p-6">
    <Badge
      variant="primary"
      class="
        mb-3 gap-1.5 bg-primary/10 px-2.5 py-0.5 text-xs font-bold text-primary
      "
    >
      <Icon name="school" class="text-xs" />
      <span>{category}</span>
    </Badge>
    <h3
      class="
        mb-3 text-2xl/tight font-bold text-secondary transition-colors
        group-hover:text-primary
        dark:text-white
      "
    >
      {title}
    </h3>
    <p class="
      mb-2 text-sm/relaxed text-secondary/60
      dark:text-slate-400
    "
    >
      {description}
    </p>
  </CardContent>
  <div class="px-6">
    <Separator class="
      bg-secondary/5
      dark:bg-slate-800
    "
    />
  </div>
  <CardFooter class="flex items-center justify-between px-6 py-4">
    <div
      class="
        flex items-center gap-2 text-xs font-semibold text-secondary/40
        dark:text-slate-400
      "
    >
      <Icon name="schedule" class="text-sm" />
      {schedule}
    </div>
    <Link
      href={url}
      color="secondary"
      class="
        font-bold
        hover:gap-2
      "
    >
      {t("see-more")}
      <Icon name="arrow_forward" class="text-sm" />
    </Link>
  </CardFooter>
</Card>
