---
/**
 * Organism: FivePillarsSection
 *
 * Displays the Five Pillars of Islam with Arabic calligraphy, transliteration,
 * and localized explanations.
 */
import { Badge } from "@/components/starwind/badge";
import { Card, CardContent } from "@/components/starwind/card";
import { useTranslations } from "@i18n/utils";
import type { TLang } from "@i18n/ui";
import { getLocalizedMocks } from "@utils/data.mocks";

export interface TPillarItem {
  number: number;
  arabicName: string;
  transliteration: string;
  title: string;
  description: string;
  icon?: string;
}

export interface Props {
  lang?: TLang;
  pillars?: TPillarItem[];
}

const { lang = "es", pillars } = Astro.props;
const t = useTranslations(lang);
const resolvedPillars
  = pillars ?? getLocalizedMocks(lang).islamFaithData.fivePillars;
---

<section class="space-y-10">
  <div class="text-center">
    <h2 class="
      text-3xl font-extrabold text-slate-900
      dark:text-white
    "
    >
      {t("islam-page.pillars-title")}
    </h2>
    <p class="
      mt-2 text-slate-600
      dark:text-slate-400
    "
    >
      {t("islam-page.pillars-subtitle")}
    </p>
  </div>

  <div class="
    grid grid-cols-1 gap-6
    sm:grid-cols-2
    lg:grid-cols-5
  "
  >
    {
      resolvedPillars.map((pillar) => (
        <Card class="
          flex flex-col justify-between rounded-2xl border border-slate-200
          bg-white shadow-sm
          dark:border-slate-800 dark:bg-slate-900
        "
        >
          <CardContent class="p-6">
            <div class="mb-4 flex items-center justify-between">
              <Badge
                variant="secondary"
                class="
                  inline-flex size-8 items-center justify-center rounded-full
                  p-0 text-xs font-extrabold
                "
              >
                {pillar.number}
              </Badge>
              <span class="text-xl font-bold text-primary" dir="rtl">
                {pillar.arabicName}
              </span>
            </div>
            <h3 class="
              text-lg font-bold text-slate-900
              dark:text-white
            "
            >
              {pillar.title}
            </h3>
            <p class="
              text-xs font-semibold text-secondary
              dark:text-blue-400
            "
            >
              {pillar.transliteration}
            </p>
            <p class="
              mt-3 text-sm/relaxed text-slate-600
              dark:text-slate-400
            "
            >
              {pillar.description}
            </p>
          </CardContent>
        </Card>
      ))
    }
  </div>
</section>
