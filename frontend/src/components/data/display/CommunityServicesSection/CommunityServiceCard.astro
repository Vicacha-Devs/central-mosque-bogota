---
import { Card, CardContent } from "@/components/starwind/card";
import Icon from "@components/data/display/Icons/Icon.astro";
import TiptapContent from "@components/data/display/TiptapContent/TiptapContent.astro";
import type { TiptapContentInput } from "@vicacha-devs/astro-tiptap-blocks";

/**
 * @component CommunityServiceCard
 * @title Community Service Card
 * @description Renders a community service feature card with a Material Symbol icon badge, title, and description inside `CommunityServicesSection`.
 *
 * Props
 * - `icon`: Material Symbol icon name
 * - `title`: service heading
 * - `description`: supporting summary text
 * - `longDescription`: optional Tiptap rich text description
 */
interface Props {
  /**
   * The icon to display in the card. Should be a valid icon name from the Icon component.
   */
  icon: string;
  /**
   * The title of the community service.
   */
  title: string;
  /**
   * A short description of the community service.
   */
  description: string;
  /**
   * Optional Tiptap rich text long description from Strapi v5.
   */
  longDescription?: TiptapContentInput;
}

const { icon, title, description, longDescription } = Astro.props as Props;
---

<Card
  class="
    group h-full rounded-2xl border-slate-100 bg-white p-0 shadow-sm
    transition-all
    hover:shadow-xl
    dark:border-slate-700 dark:bg-slate-800
    dark:hover:shadow-2xl dark:hover:shadow-black/40
  "
>
  <CardContent class="flex h-full flex-col p-8">
    <figure
      class="
        mb-6 flex size-16 items-center justify-center rounded-2xl bg-blue-50
        text-secondary transition-colors
        group-hover:bg-secondary group-hover:text-white
        dark:bg-blue-900/30 dark:text-primary
        dark:group-hover:bg-primary
      "
    >
      <Icon name={icon} class="text-3xl" />
    </figure>
    <h3 class="mb-3 text-xl font-bold">{title}</h3>
    <p class="
      leading-relaxed text-slate-600
      dark:text-slate-400
    "
    >
      {description}
    </p>
    {
      longDescription && (
        <div class="
          mt-3 border-t border-slate-100 pt-3
          dark:border-slate-700
        "
        >
          <TiptapContent content={longDescription} />
        </div>
      )
    }
  </CardContent>
</Card>
