---
/**
 * Molecule: MediaArchiveCard
 *
 * Displays a filterable media archive card (Khutbah, Podcast, or Video)
 * with aspect-ratio thumbnail, duration pill, speaker/date metadata,
 * spoken language badges, and watch/listen link.
 */
import { AspectRatio } from "@/components/starwind/aspect-ratio";
import { Badge } from "@/components/starwind/badge";
import { Card, CardContent, CardFooter } from "@/components/starwind/card";
import { Separator } from "@/components/starwind/separator";
import Icon from "@components/data/display/Icons/Icon.astro";
import type { TDetailedMediaItem } from "@utils/models/media";

export interface Props {
  /** Media item data. */
  item: TDetailedMediaItem;
  /** Localized CTA label (e.g., "Escuchar o Ver"). */
  listenOrWatchLabel: string;
}

const { item, listenOrWatchLabel } = Astro.props;
---

<Card
  id={item.slug}
  data-media-type={item.type}
  data-media-provider={item.provider}
  class="
    flex flex-col justify-between overflow-hidden rounded-2xl border
    border-slate-200 bg-white p-0 shadow-sm transition-all
    hover:shadow-md
    dark:border-slate-800 dark:bg-slate-900
  "
>
  <div>
    <AspectRatio ratio={16 / 10} class="relative overflow-hidden">
      <img
        src={item.imageUrl}
        alt={item.imageAlt}
        class="size-full object-cover"
      />
      <div
        class="
          absolute inset-0 bg-linear-to-t from-slate-950/75 via-transparent
          to-transparent
        "
      >
      </div>
      <div class="absolute top-4 left-4 flex flex-wrap items-center gap-1.5">
        <Badge
          variant="secondary"
          class="
            rounded-full bg-secondary px-3 py-1 text-xs font-bold text-white
            shadow-sm
          "
        >
          {item.typeLabel}
        </Badge>
        <Badge
          variant="outline"
          class="
            rounded-full border-0 bg-slate-950/80 px-2.5 py-1 text-[11px]
            font-semibold text-amber-300
          "
        >
          {item.providerLabel}
        </Badge>
      </div>
      <span
        class="
          absolute right-4 bottom-3 inline-flex items-center gap-1 rounded-md
          bg-slate-950/80 px-2.5 py-1 text-xs font-semibold text-white
        "
      >
        <Icon name="schedule" class="text-xs text-primary" />
        <span>{item.duration}</span>
      </span>
    </AspectRatio>

    <CardContent class="p-6">
      <div
        class="
          mb-2 flex flex-wrap items-center justify-between gap-2 text-xs
          text-slate-500
          dark:text-slate-400
        "
      >
        <span>{item.speakerName}</span>
        <span>
          {item.publishedDate}
          {item.hijriDate ? ` • ${item.hijriDate}` : ""}
        </span>
      </div>
      <h3 class="
        text-lg font-bold text-slate-900
        dark:text-white
      "
      >
        {item.title}
      </h3>
      <p class="
        mt-2 text-sm/relaxed text-slate-600
        dark:text-slate-400
      "
      >
        {item.description}
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-1.5">
        {
          item.spokenLanguages.map((code) => (
            <Badge
              variant="ghost"
              class="
                rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-bold
                tracking-wider text-slate-600 uppercase
                dark:bg-slate-800 dark:text-slate-300
              "
            >
              {code}
            </Badge>
          ))
        }
      </div>
    </CardContent>
  </div>

  <Separator class="
    bg-slate-100
    dark:bg-slate-800
  "
  />

  <CardFooter class="px-6 py-4">
    <a
      href={item.watchUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="
        inline-flex items-center gap-2 text-sm font-bold text-secondary
        transition-colors
        hover:text-primary
        dark:text-blue-300
      "
    >
      <Icon name="play_circle" class="text-lg" />
      <span>{listenOrWatchLabel}</span>
    </a>
  </CardFooter>
</Card>
