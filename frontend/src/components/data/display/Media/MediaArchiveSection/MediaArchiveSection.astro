---
/**
 * Organism: MediaArchiveSection
 *
 * Renders the Live Stream Spotlight Banner and Filterable Media Archive
 * (Khutbahs, Podcasts, Videos) with RSS 2.0 feed link and `MediaArchiveCard` molecules.
 */
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { Card } from "@/components/starwind/card";
import Icon from "@components/data/display/Icons/Icon.astro";
import MediaArchiveCard from "./MediaArchiveCard.astro";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import type { TLang } from "@i18n/ui";
import { getDetailedMediaHighlights } from "@utils/localized-mocks";
import type { TDetailedMediaItem } from "@utils/models/media";

export interface Props {
  lang?: TLang;
  items?: TDetailedMediaItem[];
}

const { lang = "es", items } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const mediaItems = items ?? getDetailedMediaHighlights(lang);
const rssFeedHref = `/api/media-feeds/rss.xml?locale=${lang}`;
const spotlightItem = mediaItems[0];
---

<div class="space-y-12">
  <!-- Live Stream Spotlight Banner -->
  {
    spotlightItem && (
      <Card class="
        overflow-hidden rounded-3xl border border-slate-200 bg-slate-900 p-0
        text-white shadow-xl
        dark:border-slate-800
      "
      >
        <div class="
          grid grid-cols-1
          lg:grid-cols-12
        "
        >
          <div class="
            flex flex-col justify-between p-8
            sm:p-10
            lg:col-span-7
          "
          >
            <div class="space-y-4">
              <div class="flex flex-wrap items-center gap-2">
                <Badge
                  variant="error"
                  class="
                    gap-2 rounded-full border-0 bg-red-500/20 px-3.5 py-1
                    text-xs font-extrabold tracking-wider text-red-300 uppercase
                  "
                >
                  <span class="size-2 rounded-full bg-red-400" />
                  <span>{t("media-page.live-badge")}</span>
                </Badge>
                <Badge
                  variant="outline"
                  class="
                    rounded-full border-0 bg-white/10 px-3 py-1 text-xs
                    font-semibold text-slate-200 uppercase
                  "
                >
                  AR • ES • EN • TR
                </Badge>
              </div>
              <h2 class="
                text-2xl font-extrabold
                sm:text-3xl
              "
              >
                {t("media-page.live-title")}
              </h2>
              <p class="text-sm font-semibold text-amber-300">
                {t("media-page.live-schedule")}
              </p>
              <p class="text-sm/relaxed text-slate-300">
                {t("media-page.live-desc")}
              </p>
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-4">
              <Button
                href={spotlightItem.watchUrl}
                target="_blank"
                rel="noopener noreferrer"
                variant="primary"
              >
                <Icon name="play_circle" />
                <span>{t("media-page.watch-youtube")}</span>
              </Button>
              <Button
                href={translatePath("/prayer-information")}
                variant="outline"
                class="
                  border-white/30 bg-transparent text-white
                  hover:bg-white/10
                "
              >
                <Icon name="schedule" />
                <span>{t("media-page.prayer-schedule")}</span>
              </Button>
              <a
                href={rssFeedHref}
                target="_blank"
                rel="noopener noreferrer"
                class="
                  inline-flex items-center gap-1.5 rounded-full border
                  border-amber-400/40 bg-amber-400/10 px-4 py-2 text-xs
                  font-bold text-amber-300 transition-colors
                  hover:bg-amber-400/20
                "
              >
                <Icon name="rss_feed" class="text-sm" />
                <span>
                  Podcast RSS 2.0 (
                  {lang.toUpperCase()}
                  )
                </span>
              </a>
            </div>
          </div>

          <div class="
            relative min-h-64
            lg:col-span-5
          "
          >
            <img
              src={spotlightItem.imageUrl}
              alt={spotlightItem.imageAlt}
              class="size-full object-cover opacity-80"
            />
            <div class="
              absolute inset-0 flex items-center justify-center bg-slate-950/40
            "
            >
              <a
                href={spotlightItem.watchUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t("media-page.watch-youtube")}
                class="
                  flex size-16 items-center justify-center rounded-full
                  bg-primary text-slate-950 shadow-2xl transition-transform
                  hover:scale-105
                "
              >
                <Icon name="play_arrow" class="text-4xl" />
              </a>
            </div>
          </div>
        </div>
      </Card>
    )
  }

  <!-- Filterable Media Archive -->
  <section class="space-y-8">
    <div
      class="flex flex-wrap items-center justify-center gap-3"
      role="tablist"
    >
      <button
        type="button"
        data-media-filter="all"
        class="
          cursor-pointer rounded-full bg-secondary px-5 py-2 text-sm font-bold
          text-white shadow-sm transition-colors
        "
      >
        {t("media-page.filter-all")}
      </button>
      <button
        type="button"
        data-media-filter="khutbah"
        class="
          cursor-pointer rounded-full border border-slate-300 bg-white px-5 py-2
          text-sm font-semibold text-slate-700 transition-colors
          hover:bg-slate-100
          dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200
        "
      >
        {t("media-page.filter-khutbah")}
      </button>
      <button
        type="button"
        data-media-filter="podcast"
        class="
          cursor-pointer rounded-full border border-slate-300 bg-white px-5 py-2
          text-sm font-semibold text-slate-700 transition-colors
          hover:bg-slate-100
          dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200
        "
      >
        {t("media-page.filter-podcast")}
      </button>
      <button
        type="button"
        data-media-filter="video"
        class="
          cursor-pointer rounded-full border border-slate-300 bg-white px-5 py-2
          text-sm font-semibold text-slate-700 transition-colors
          hover:bg-slate-100
          dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200
        "
      >
        {t("media-page.filter-video")}
      </button>
    </div>

    <div class="
      grid grid-cols-1 gap-8
      md:grid-cols-2
      lg:grid-cols-3
    "
    >
      {
        mediaItems.map((item) => (
          <MediaArchiveCard
            item={item}
            listenOrWatchLabel={t("media-page.listen-or-watch")}
          />
        ))
      }
    </div>
  </section>
</div>

<script>
  import { initMediaFilters } from "./media-archive.controller";

  initMediaFilters();
  document.addEventListener("astro:after-swap", initMediaFilters);
</script>
