---
import { Badge } from "@/components/starwind/badge";
import { Card, CardContent } from "@/components/starwind/card";
import { Separator } from "@/components/starwind/separator";
import type { TScriptureHadithCard } from "@utils/islam-suite-mocks";

/**
 * @component ScriptureHadithCard
 * @title Authentic Hadith Card
 * @description Renders an authenticated Hadith card with collection reference, grading badge (Sahih/Hasan), Arabic text, localized translation, and takeaway reflection.
 *
 * Props
 * - `hadith`: Hadith card model (`TScriptureHadithCard`)
 * - `takeawayLabel`: localized takeaway label
 *
 * @preview
 *
 * <ScriptureHadithCard
 *   hadith={{
 *     id: "hadith-bukhari-1",
 *     collectionName: "Sahih al-Bujari",
 *     hadithNumber: "1",
 *     grading: "Sahih",
 *     narrator: "Umar ibn al-Jattab (RA)",
 *     arabicText: "إِنَّمَا الأَعْمَالُ بِالنِّيَّاتِ",
 *     translation: "Ciertamente las acciones dependen de las intenciones.",
 *     keyTakeaway: "La sinceridad del corazón define el valor espiritual de cada obra."
 *   }}
 *   takeawayLabel="Enseñanza clave"
 * />
 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import ScriptureHadithCard from "@components/data/display/ScriptureExplorerSection/ScriptureHadithCard.astro";
 * ---
 *
 * <ScriptureHadithCard hadith={hadithItem} takeawayLabel="Enseñanza clave" />
 * ```
 */
interface Props {
  /**
   * Authenticated Hadith card model.
   */
  hadith: TScriptureHadithCard;
  /**
   * Localized label for the takeaway section.
   */
  takeawayLabel: string;
}

const { hadith, takeawayLabel } = Astro.props;
---

<Card
  class="
    flex flex-col justify-between rounded-2xl border border-slate-200 bg-white
    p-0 shadow-sm
    dark:border-slate-800 dark:bg-slate-900
  "
  data-scripture-hadith-card={hadith.id}
>
  <CardContent class="flex h-full flex-col justify-between p-6">
    <div class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <span class="
          text-xs font-bold text-secondary
          dark:text-blue-300
        "
        >
          {hadith.collectionName}
          {" "}
          #
          {hadith.hadithNumber}
        </span>
        <Badge
          variant="success"
          class="rounded-full px-2.5 py-0.5 text-[11px] font-bold"
        >
          {hadith.grading}
        </Badge>
      </div>

      <p
        class="
          text-right text-xl/loose font-bold text-slate-900
          dark:text-white
        "
        dir="rtl"
        lang="ar"
      >
        {hadith.arabicText}
      </p>

      <p class="
        text-sm/relaxed text-slate-700
        dark:text-slate-200
      "
      >
        “
        {hadith.translation}
        ”
      </p>
    </div>

    <div class="mt-6 space-y-2">
      <Separator class="
        bg-slate-100
        dark:bg-slate-800
      "
      />
      <p class="
        text-xs text-slate-500
        dark:text-slate-400
      "
      >
        <strong class="
          text-slate-700
          dark:text-slate-200
        "
        >
          {takeawayLabel}
          :
        </strong>
        {" "}
        {hadith.keyTakeaway}
      </p>
    </div>
  </CardContent>
</Card>
