---
import { Badge } from "@/components/starwind/badge";
import { Card, CardContent } from "@/components/starwind/card";
import type { TResourceGlossaryTerm } from "@utils/resources-mocks";

/**
 * @component GlossaryTermCard
 * @title Glossary Term Card
 * @description Renders an alphabetical Islamic glossary card (`plugin::resources.glossary-term`) with letter badge, term, phonetic transliteration, RTL native Arabic script, definition, and related term tags.
 *
 * Props
 * - `term`: glossary term object (`TResourceGlossaryTerm`)
 *
 * @preview
 *
 * <div class="max-w-md">
 *   <GlossaryTermCard term={term} />
 * </div>
 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import GlossaryTermCard from "@components/data/display/Resources/PublicationsAndGlossarySection/GlossaryTermCard.astro";
 * import { getLocalizedGlossaryTerms } from "@utils/resources-mocks";
 *
 * const [term] = getLocalizedGlossaryTerms("es");
 * ---
 *
 * <GlossaryTermCard term={term} />
 * ```
 */
interface Props {
  /**
   * Islamic glossary term item to render.
   */
  term: TResourceGlossaryTerm;
}

const { term } = Astro.props as Props;
---

<Card
  data-glossary-card={term.letterGroup}
  class="
    gap-0 rounded-2xl border-slate-200 bg-white p-6 shadow-sm
    dark:border-slate-800 dark:bg-slate-900
  "
>
  <CardContent class="p-0">
    <div class="flex items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span
            class="
              inline-flex size-7 items-center justify-center rounded-full
              bg-secondary text-xs font-extrabold text-white
            "
          >
            {term.letterGroup}
          </span>
          <h3 class="
            text-lg font-bold text-slate-900
            dark:text-white
          "
          >
            {term.term}
          </h3>
          <span class="
            text-xs font-semibold text-secondary
            dark:text-blue-300
          "
          >
            (
            {term.transliteration}
            )
          </span>
        </div>
        <span class="mt-1 inline-block text-xs font-medium text-slate-500">
          {term.categoryLabel}
        </span>
      </div>
      <span class="text-2xl font-bold text-primary" dir="rtl">
        {term.nativeScript}
      </span>
    </div>

    <p class="
      mt-3 text-sm/relaxed text-slate-600
      dark:text-slate-400
    "
    >
      {term.definition}
    </p>

    {
      term.relatedTerms.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {term.relatedTerms.map((rel) => (
            <Badge
              variant="outline"
              class="
                rounded-md bg-slate-100 px-2.5 py-0.5 text-xs font-semibold
                text-slate-600
                dark:bg-slate-800 dark:text-slate-300
              "
            >
              {rel}
            </Badge>
          ))}
        </div>
      )
    }
  </CardContent>
</Card>
