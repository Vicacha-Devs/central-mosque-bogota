---
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { Card, CardContent, CardFooter } from "@/components/starwind/card";
import { Separator } from "@/components/starwind/separator";
import Icon from "@components/data/display/Icons/Icon.astro";
import type { TResourcePublication } from "@utils/resources-mocks";

/**
 * @component PublicationCard
 * @title Publication Card
 * @description Renders a downloadable publication card (PDF/ePub) from the Strapi v5 Media Library (`plugin::upload.file`) with category badge, Hijri/Gregorian date, author, page count, file size, summary, and verified download button.
 *
 * Props
 * - `publication`: publication metadata (`TResourcePublication`)
 * - `pagesLabel`: localized word for pages (e.g. `"páginas"`, `"pages"`)
 * - `downloadLabel`: localized download button text
 *
 * @preview
 *
 * <div class="max-w-sm">
 *   <PublicationCard
 *     publication={publication}
 *     pagesLabel="páginas"
 *     downloadLabel="Descargar PDF"
 *   />
 * </div>
 *
 * @usage
 *
 * ```astro nocollapse
 * ---
 * import PublicationCard from "@components/data/display/Resources/PublicationsAndGlossarySection/PublicationCard.astro";
 * import { getLocalizedPublications, getResourcesHubCopy } from "@utils/resources-mocks";
 *
 * const copy = getResourcesHubCopy("es");
 * const [publication] = getLocalizedPublications("es");
 * ---
 *
 * <PublicationCard
 *   publication={publication}
 *   pagesLabel={copy.pagesLabel}
 *   downloadLabel={copy.downloadLabel}
 * />
 * ```
 */
interface Props {
  /**
   * Publication metadata to render.
   */
  publication: TResourcePublication;
  /**
   * Localized label for the page count.
   */
  pagesLabel: string;
  /**
   * Localized label for the download button.
   */
  downloadLabel: string;
}

const { publication, pagesLabel, downloadLabel } = Astro.props as Props;
---

<Card
  class="
    flex flex-col justify-between gap-0 rounded-2xl border-slate-200 bg-white
    p-6 shadow-sm transition-shadow
    hover:shadow-md
    dark:border-slate-800 dark:bg-slate-900
  "
>
  <CardContent class="p-0">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <Badge
        variant="secondary"
        class="bg-secondary px-3 py-1 text-xs font-bold text-white"
      >
        {publication.categoryLabel}
      </Badge>
      <span class="
        text-xs font-semibold text-amber-700
        dark:text-amber-300
      "
      >
        {publication.secondaryDateFormatted}
      </span>
    </div>

    <h3 class="
      text-lg font-bold text-slate-900
      dark:text-white
    "
    >
      {publication.title}
    </h3>
    <p class="
      mt-1 text-xs font-medium text-slate-500
      dark:text-slate-400
    "
    >
      {publication.authorName}
      {" "}
      •
      {publication.pageCount}
      {pagesLabel}
      {" "}
      •
      {" "}
      {publication.fileSizeLabel}
    </p>
    <p class="
      mt-3 text-sm/relaxed text-slate-600
      dark:text-slate-400
    "
    >
      {publication.summary}
    </p>
  </CardContent>

  <div class="mt-6">
    <Separator class="
      mb-4 bg-slate-100
      dark:bg-slate-800
    "
    />
    <CardFooter class="flex items-center justify-between p-0">
      <span class="font-mono text-[11px] text-slate-400">
        {publication.mediaFolderPath}
      </span>
      <Button
        href={publication.externalDownloadUrl}
        download
        variant="primary"
        size="sm"
        class="
          rounded-full text-xs font-extrabold transition-transform
          hover:scale-105
        "
      >
        <Icon name="download" class="text-sm" />
        <span>{downloadLabel}</span>
      </Button>
    </CardFooter>
  </div>
</Card>
