---
import { Badge } from "@/components/starwind/badge";
import {
  InputGroup,
  InputGroupAddon,
  InputGroupInput,
} from "@/components/starwind/input-group";
import Icon from "@components/data/display/Icons/Icon.astro";
import type { TLang } from "@i18n/ui";
import { getLangFromUrl, useTranslations } from "@i18n/utils";

/**
 * @component SiteSearchSection
 * @title Global Site Search Section
 * @description Renders a live search input, category filter tabs, and instant filterable cards for articles, events, services, media highlights, and FAQs.
 *
 * i18n keys
 * - `search-page.placeholder`
 * - `search-page.filter-all`
 * - `search-page.filter-article`
 * - `search-page.filter-event`
 * - `search-page.filter-service`
 * - `search-page.filter-media`
 * - `search-page.filter-faq`
 * - `search-page.no-results`
 * - `search-page.view-result`
 */
export interface TSearchIndexItem {
  id: string;
  category: "article" | "event" | "service" | "media" | "faq";
  categoryLabel: string;
  title: string;
  description: string;
  href: string;
  icon: string;
}

interface Props {
  /**
   * Optional locale override (`es`, `en`, `ar`, `tr`).
   */
  lang?: TLang;
  /**
   * Indexed items across all categories to filter and display.
   */
  items: Array<TSearchIndexItem>;
}

const { lang: langProp, items } = Astro.props as Props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const filterTabs = [
  { key: "all", label: t("search-page.filter-all") },
  { key: "article", label: t("search-page.filter-article") },
  { key: "event", label: t("search-page.filter-event") },
  { key: "service", label: t("search-page.filter-service") },
  { key: "media", label: t("search-page.filter-media") },
  { key: "faq", label: t("search-page.filter-faq") },
] as const;
---

<section data-site-search class="space-y-8">
  <!-- Search Input Box -->
  <div class="mx-auto max-w-3xl">
    <InputGroup class="
      h-14 rounded-2xl bg-white shadow-sm
      dark:bg-slate-900
    "
    >
      <InputGroupAddon align="inline-start" class="ps-4">
        <Icon name="search" class="text-2xl text-slate-400" />
      </InputGroupAddon>
      <InputGroupInput
        id="site-search-input"
        type="search"
        placeholder={t("search-page.placeholder")}
        aria-label={t("search-page.placeholder")}
        class="pe-5 text-base"
      />
    </InputGroup>
  </div>

  <!-- Category Filter Tabs -->
  <div
    class="flex flex-wrap items-center justify-center gap-3"
    role="tablist"
  >
    {
      filterTabs.map((tab, idx) => (
        <button
          type="button"
          data-search-filter={tab.key}
          class:list={[
            `
              cursor-pointer rounded-full px-5 py-2 text-sm font-bold
              transition-colors
            `,
            idx === 0
              ? "bg-secondary text-white shadow-sm"
              : `
                border border-slate-300 bg-white text-slate-700
                hover:bg-slate-100
                dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200
              `,
          ]}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  <!-- Results Grid -->
  <div
    id="site-search-results"
    class="
      grid grid-cols-1 gap-6
      md:grid-cols-2
      lg:grid-cols-3
    "
  >
    {
      items.map((item) => (
        <a
          href={item.href}
          data-search-item
          data-search-category={item.category}
          data-search-text={`${item.title} ${item.description} ${item.categoryLabel}`.toLowerCase()}
          class="
            group flex flex-col justify-between rounded-2xl border
            border-slate-200 bg-white p-6 shadow-sm transition-all
            hover:-translate-y-1 hover:shadow-md
            dark:border-slate-800 dark:bg-slate-900
          "
        >
          <div>
            <div class="mb-3 flex items-center justify-between">
              <Badge
                variant="secondary"
                class="
                  gap-1.5 bg-secondary/10 px-3 py-1 text-xs font-bold
                  text-secondary
                  dark:bg-blue-400/10 dark:text-blue-300
                "
              >
                <Icon name={item.icon} class="text-sm" />
                <span>{item.categoryLabel}</span>
              </Badge>
            </div>
            <h3 class="
              text-lg font-bold text-slate-900
              group-hover:text-secondary
              dark:text-white
              dark:group-hover:text-primary
            "
            >
              {item.title}
            </h3>
            <p class="
              mt-2 line-clamp-3 text-sm/relaxed text-slate-600
              dark:text-slate-400
            "
            >
              {item.description}
            </p>
          </div>

          <div class="
            mt-5 inline-flex items-center gap-1.5 text-xs font-extrabold
            text-secondary
            group-hover:text-primary
            dark:text-blue-300
          "
          >
            <span>{t("search-page.view-result")}</span>
            <Icon name="arrow_forward" class="text-sm" />
          </div>
        </a>
      ))
    }
  </div>

  <!-- Empty State -->
  <div
    id="site-search-empty"
    class="
      hidden rounded-2xl border border-slate-200 bg-white p-10 text-center
      text-slate-600
      dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400
    "
  >
    <Icon name="search_off" class="mx-auto mb-2 text-4xl text-slate-400" />
    <p class="text-base font-semibold">{t("search-page.no-results")}</p>
  </div>
</section>

<script>
  import { initSiteSearch } from "./site-search.controller";

  initSiteSearch();
  document.addEventListener("astro:after-swap", () => initSiteSearch());
</script>
