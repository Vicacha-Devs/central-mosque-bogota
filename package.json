{
  "name": "central-mosque-bogota-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Central Mosque of Bogotá (Mezquita Central Abu Bakr As-Siddiq) — Full-Stack Monorepo (Astro 7 SSR Frontend, Strapi v5 CMS Backend, and Astro Starlight + Pele + TypeDoc Documentation)",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter @central-mosque-bogota/backend develop",
    "dev:docs": "pnpm --filter @central-mosque-bogota/docs dev",
    "build:frontend": "pnpm --filter frontend build",
    "build:storybook": "pnpm --filter frontend build:storybook",
    "build:docs": "pnpm --filter @central-mosque-bogota/docs build",
    "test:unit": "pnpm --filter frontend test:unit --run",
    "test:coverage": "pnpm --filter frontend test:unit --run --coverage",
    "verify": "node ./scripts/verify-all.ts"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.3"
}
