---
import ProgressPrimitive from "@starwind-ui/astro/progress";
import type { HTMLAttributes } from "astro/types";
import { progress, progressIndicator, progressTrack } from "./variants";

interface Props extends Omit<HTMLAttributes<"div">, "value"> {
  label?: string;
  max?: number;
  min?: number;
  value?: number | null;
  variant?: "default" | "primary" | "secondary" | "info" | "success" | "warning" | "error";
}

const {
  label,
  value = null,
  max = 100,
  min = 0,
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const ariaLabel = rest["aria-label"] ?? label;
const boundedMin = Number.isFinite(min) ? min : 0;
const boundedMax = Number.isFinite(max) ? max : 100;
const normalizedMin = Math.min(boundedMin, boundedMax);
const normalizedMax = Math.max(boundedMin, boundedMax);
const hasValue = value != null && Number.isFinite(Number(value));
const progressValue = hasValue
  ? Math.min(Math.max(Number(value), normalizedMin), normalizedMax)
  : null;
const isIndeterminate = progressValue === null;
const range = normalizedMax - normalizedMin;
let progressPercent = 0;
if (progressValue !== null) {
  if (range === 0) {
    progressPercent = progressValue >= normalizedMax ? 100 : 0;
  }
  else {
    const ratio = (progressValue - normalizedMin) / range;
    progressPercent = Math.round(Math.min(Math.max(ratio * 100, 0), 100));
  }
}
const indicatorStyle = isIndeterminate ? undefined : { transform: `translateX(-${100 - progressPercent}%)` };
---

{/* TODO: drop aria-value* once Starwind renders them server-side, see https://github.com/starwind-ui/starwind-ui/issues/297 */}
<ProgressPrimitive.Root
  class={progress({ variant: isIndeterminate ? "indeterminate" : undefined, class: className })}
  max={normalizedMax}
  min={normalizedMin}
  value={progressValue}
  {...rest}
  aria-label={ariaLabel}
  aria-valuemin={normalizedMin}
  aria-valuemax={normalizedMax}
  aria-valuenow={progressValue ?? undefined}
  data-slot="progress"
>
  <ProgressPrimitive.Track class={progressTrack()} data-slot="progress-track">
    <ProgressPrimitive.Indicator
      class={progressIndicator({ variant: isIndeterminate ? "indeterminate" : undefined, color: variant })}
      style={indicatorStyle}
      data-slot="progress-indicator"
    />
  </ProgressPrimitive.Track>
</ProgressPrimitive.Root>
