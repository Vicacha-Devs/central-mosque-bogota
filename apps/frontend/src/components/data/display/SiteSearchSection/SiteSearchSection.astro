---
import { Badge } from "@/components/starwind/badge";
import {
  InputGroup,
  InputGroupAddon,
  InputGroupInput,
} from "@/components/starwind/input-group";
import Icon from "@components/data/display/Icons/Icon.astro";
import type { TLang } from "@i18n/ui";
import { getLangFromUrl, useTranslatedPath, useTranslations } from "@i18n/utils";
import { toSafeHref } from "@utils/url.utils";

/**
 * @component SiteSearchSection
 * @title Global Site Search Section
 * @description Renders a live search input, category filter tabs, and instant filterable cards for articles, events, services, media highlights, and FAQs.
 *
 * i18n keys
 * - `search-page.placeholder`
 * - `search-page.filter-all`
 * - `search-page.filter-article`
 * - `search-page.filter-event`
 * - `search-page.filter-service`
 * - `search-page.filter-media`
 * - `search-page.filter-faq`
 * - `search-page.no-results`
 * - `search-page.view-result`
 */
export interface TSearchIndexItem {
  id: string;
  category: "article" | "event" | "service" | "media" | "faq";
  categoryLabel: string;
  title: string;
  description: string;
  href: string;
  icon: string;
}

interface Props {
  /**
   * Optional locale override (`es`, `en`, `ar`, `tr`).
   */
  lang?: TLang;
  /**
   * Indexed items across all categories to filter and display.
   */
  items: Array<TSearchIndexItem>;
}

const { lang: langProp, items } = Astro.props as Props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const countByCategory = new Map<string, number>();
for (const item of items) {
  countByCategory.set(
    item.category,
    (countByCategory.get(item.category) ?? 0) + 1
  );
}

const filterTabs = [
  { key: "all", label: t("search-page.filter-all"), count: items.length },
  {
    key: "article",
    label: t("search-page.filter-article"),
    count: countByCategory.get("article") ?? 0,
  },
  {
    key: "event",
    label: t("search-page.filter-event"),
    count: countByCategory.get("event") ?? 0,
  },
  {
    key: "service",
    label: t("search-page.filter-service"),
    count: countByCategory.get("service") ?? 0,
  },
  {
    key: "media",
    label: t("search-page.filter-media"),
    count: countByCategory.get("media") ?? 0,
  },
  {
    key: "faq",
    label: t("search-page.filter-faq"),
    count: countByCategory.get("faq") ?? 0,
  },
] as const;
---

<section data-site-search class="space-y-8">
  <!-- Search Input Box -->
  <div class="mx-auto max-w-3xl">
    <InputGroup class="h-14 rounded-2xl bg-card shadow-sm">
      <InputGroupAddon align="inline-start" class="ps-4">
        <Icon name="search" class="text-2xl text-slate-400" />
      </InputGroupAddon>
      <InputGroupInput
        id="site-search-input"
        type="search"
        placeholder={t("search-page.placeholder")}
        aria-label={t("search-page.placeholder")}
        class="pe-5 text-base"
      />
    </InputGroup>
  </div>

  <!-- Category Filter Tabs -->
  <div
    class="flex flex-wrap items-center justify-center gap-3"
    role="tablist"
  >
    {
      filterTabs.map((tab, idx) => (
        <button
          type="button"
          data-search-filter={tab.key}
          aria-label={tab.label}
          class:list={[
            `
              inline-flex cursor-pointer items-center gap-1.5 rounded-full px-5
              py-2 text-sm font-bold transition-colors
            `,
            idx === 0
              ? "bg-secondary text-white shadow-sm"
              : `
                border border-border bg-card text-foreground
                hover:bg-muted
              `,
          ]}
        >
          <span>{tab.label}</span>
          <span aria-hidden="true" class="text-xs tabular-nums opacity-75">
            (
            {tab.count}
            )
          </span>
        </button>
      ))
    }
  </div>

  <!-- Results Grid -->
  <div
    id="site-search-results"
    class="
      grid grid-cols-1 gap-6
      md:grid-cols-2
      lg:grid-cols-3
    "
  >
    {
      items.map((item) => (
        <a
          href={toSafeHref(item.href)}
          data-search-item
          data-search-category={item.category}
          data-search-text={`${item.title} ${item.description} ${item.categoryLabel}`.toLowerCase()}
          class="
            group flex flex-col justify-between rounded-2xl border
            border-slate-200 bg-white p-6 shadow-sm transition-all
            hover:-translate-y-1 hover:shadow-md
            dark:border-slate-800 dark:bg-slate-900
          "
        >
          <div>
            <div class="mb-3 flex items-center justify-between">
              <Badge
                variant="secondary"
                class="
                  gap-1.5 bg-secondary/10 px-3 py-1 text-xs font-bold
                  text-secondary
                  dark:bg-blue-400/10 dark:text-blue-300
                "
              >
                <Icon name={item.icon} class="text-sm" />
                <span>{item.categoryLabel}</span>
              </Badge>
            </div>
            <h3 class="
              text-lg font-bold text-slate-900
              group-hover:text-secondary
              dark:text-white
              dark:group-hover:text-primary
            "
            >
              {item.title}
            </h3>
            <p class="
              mt-2 line-clamp-3 text-sm/relaxed text-slate-600
              dark:text-slate-400
            "
            >
              {item.description}
            </p>
          </div>

          <div class="
            mt-5 inline-flex items-center gap-1.5 text-xs font-extrabold
            text-secondary
            group-hover:text-primary
            dark:text-blue-300
          "
          >
            <span>{t("search-page.view-result")}</span>
            <Icon name="arrow_forward" class="text-sm" />
          </div>
        </a>
      ))
    }
  </div>

  <!-- Empty State -->
  <div
    id="site-search-empty"
    class="
      hidden rounded-2xl border border-border bg-card p-10 text-center
      text-muted-foreground
    "
  >
    <Icon name="search_off" class="mx-auto mb-2 text-4xl text-slate-400" />
    <p class="text-base font-semibold">{t("search-page.no-results")}</p>
  </div>

  <!-- Recovery Strip -->
  <div
    class="
      flex flex-col items-start justify-between gap-6 rounded-3xl
      bg-surface-sand p-6
      sm:p-8
      md:flex-row md:items-center
    "
  >
    <div class="space-y-1 text-start">
      <h3 class="text-lg font-extrabold text-foreground">
        {t("search-page.recovery-title")}
      </h3>
      <p class="text-sm text-muted-foreground">
        {t("search-page.recovery-desc")}
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a
        href={translatePath("/prayer-information")}
        class="
          rounded-full border border-border bg-card px-4 py-2 text-xs font-bold
          text-foreground transition-colors
          hover:bg-muted
        "
      >
        {t("pray-schedule.title")}
      </a>
      <a
        href={translatePath("/events-and-programs")}
        class="
          rounded-full border border-border bg-card px-4 py-2 text-xs font-bold
          text-foreground transition-colors
          hover:bg-muted
        "
      >
        {t("events-page.title")}
      </a>
      <a
        href={translatePath("/contact-and-visit")}
        class="
          rounded-full bg-secondary px-4 py-2 text-xs font-bold
          text-secondary-foreground transition-opacity
          hover:opacity-90
        "
      >
        {t("footer.contact")}
      </a>
    </div>
  </div>
</section>

<script>
  import { initSiteSearch } from "./site-search.controller";

  initSiteSearch();
  document.addEventListener("astro:after-swap", () => initSiteSearch());
</script>
