---
import { Card } from "@/components/starwind/card";
import { Skeleton } from "@/components/starwind/skeleton";

const skeletonRows = Array.from({ length: 7 });
---

<section
  aria-busy="true"
  aria-live="polite"
  class="mx-auto w-full max-w-5xl px-4"
>
  <Card
    class="
      gap-0 overflow-hidden rounded-3xl border border-slate-200 bg-card p-0
      shadow-xl
      dark:border-slate-800
    "
  >
    <div
      class="
        flex flex-col items-center justify-between gap-6 border-b
        border-slate-100 p-6
        md:flex-row md:p-8
        dark:border-slate-800
      "
    >
      <div class="
        flex w-full flex-col gap-2.5
        md:w-1/2
      "
      >
        <Skeleton class="h-8 w-56 rounded-lg" />
        <Skeleton class="h-4 w-72 max-w-full rounded-md" />
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <Skeleton class="h-10 w-40 rounded-xl" />
        <Skeleton class="h-10 w-36 rounded-xl" />
        <Skeleton class="h-10 w-36 rounded-xl" />
      </div>
    </div>

    <div class="
      h-12 bg-secondary/80
      dark:bg-primary/20
    "
    >
    </div>

    <div class="
      divide-y divide-slate-100
      dark:divide-slate-800
    "
    >
      {
        skeletonRows.map(() => (
          <div
            class="grid grid-cols-7 items-center gap-4 px-8 py-4"
          >
            <div class="col-span-1 space-y-1.5">
              <Skeleton class="h-4 w-28 rounded-sm" />
              <Skeleton class="h-3 w-20 rounded-sm" />
            </div>
            <Skeleton class="mx-auto h-4 w-12 rounded-sm" />
            <Skeleton class="mx-auto h-4 w-12 rounded-sm" />
            <Skeleton class="mx-auto h-4 w-12 rounded-sm" />
            <Skeleton class="mx-auto h-4 w-12 rounded-sm" />
            <Skeleton class="mx-auto h-4 w-12 rounded-sm" />
            <Skeleton class="mx-auto h-4 w-12 rounded-sm" />
          </div>
        ))
      }
    </div>

    <div class="
      h-12 bg-secondary
      dark:bg-primary
    "
    >
    </div>
  </Card>
</section>
