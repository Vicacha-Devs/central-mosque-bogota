---
/**
 * Organism: MediaArchiveSection
 *
 * Renders the Live Stream Spotlight Banner and Filterable Media Archive
 * (Khutbahs, Podcasts, Videos) with RSS 2.0 feed link and `MediaArchiveCard` molecules.
 */
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { Card } from "@/components/starwind/card";
import Icon from "@components/data/display/Icons/Icon.astro";
import MediaArchiveCard from "./MediaArchiveCard.astro";
import { useTranslatedPath, useTranslations } from "@i18n/utils";
import type { TLang } from "@i18n/ui";
import { getDetailedMediaHighlights } from "@utils/localized-mocks";
import type { TDetailedMediaItem } from "@utils/models/media";
import { toSafeHref } from "@utils/url.utils";

export interface Props {
  lang?: TLang;
  items?: TDetailedMediaItem[];
}

const { lang = "es", items } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const mediaItems = items ?? getDetailedMediaHighlights(lang);
const rssFeedHref = `/api/media-feeds/rss.xml?locale=${lang}`;
const spotlightItem = mediaItems[0];
---

<div class="space-y-12">
  <!-- Live Stream Spotlight Banner -->
  {
    spotlightItem && (
      <Card class="
        overflow-hidden rounded-3xl border border-slate-200 bg-slate-900 p-0
        text-white shadow-xl
        dark:border-slate-800
      "
      >
        <div class="
          grid grid-cols-1
          lg:grid-cols-12
        "
        >
          <div class="
            flex flex-col justify-between p-8
            sm:p-10
            lg:col-span-7
          "
          >
            <div class="space-y-4">
              <div class="flex flex-wrap items-center gap-2">
                <Badge
                  variant="error"
                  class="
                    gap-2 rounded-full border-0 bg-red-500/20 px-3.5 py-1
                    text-xs font-extrabold tracking-wider text-red-300 uppercase
                  "
                >
                  <span class="size-2 rounded-full bg-red-400" />
                  <span>{t("media-page.live-badge")}</span>
                </Badge>
                <Badge
                  variant="outline"
                  class="
                    rounded-full border-0 bg-white/10 px-3 py-1 text-xs
                    font-semibold text-slate-200 uppercase
                  "
                >
                  AR • ES • EN • TR
                </Badge>
              </div>
              <h2 class="
                text-2xl font-extrabold
                sm:text-3xl
              "
              >
                {t("media-page.live-title")}
              </h2>
              <p class="text-sm font-semibold text-amber-300">
                {t("media-page.live-schedule")}
              </p>
              <p class="text-sm/relaxed text-slate-300">
                {t("media-page.live-desc")}
              </p>
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-4">
              <Button
                href={toSafeHref(spotlightItem.watchUrl)}
                target="_blank"
                rel="noopener noreferrer"
                variant="primary"
              >
                <Icon name="play_circle" />
                <span>{t("media-page.watch-youtube")}</span>
              </Button>
              <Button
                href={translatePath("/prayer-information")}
                variant="outline"
                class="
                  border-white/30 bg-transparent text-white
                  hover:border-white/50 hover:bg-white/15 hover:text-white
                "
              >
                <Icon name="schedule" />
                <span>{t("media-page.prayer-schedule")}</span>
              </Button>
              <a
                href={rssFeedHref}
                target="_blank"
                rel="noopener noreferrer"
                class="
                  inline-flex items-center gap-1.5 rounded-full border
                  border-amber-400/40 bg-amber-400/10 px-4 py-2 text-xs
                  font-bold text-amber-300 transition-colors
                  hover:bg-amber-400/20
                "
              >
                <Icon name="rss_feed" class="text-sm" />
                <span>
                  {t("media-page.podcastRssLabel")}
                  {" ("}
                  {lang.toUpperCase()}
                  )
                </span>
              </a>
            </div>

            <div class="
              mt-6 grid grid-cols-1 gap-3 border-t border-white/10 pt-5
              sm:grid-cols-2
            "
            >
              <div class="rounded-xl bg-white/5 p-3.5 text-start">
                <span class="
                  block text-[11px] font-extrabold tracking-wider text-amber-300
                  uppercase
                "
                >
                  {t("media-page.companion-takeaways")}
                </span>
                <p class="mt-1 text-xs/relaxed text-slate-200">
                  {spotlightItem.description}
                </p>
              </div>
              <div class="rounded-xl bg-white/5 p-3.5 text-start">
                <span class="
                  block text-[11px] font-extrabold tracking-wider text-amber-300
                  uppercase
                "
                >
                  {t("media-page.companion-verses")}
                </span>
                <p dir="rtl" class="mt-1 font-arabic text-sm text-white">
                  يَا أَيُّهَا الَّذِينَ آمَنُوا
                  اسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ
                </p>
              </div>
            </div>
          </div>

          <div
            class="
              relative min-h-64 bg-secondary
              lg:col-span-5
            "
          >
            {
              spotlightItem.imageUrl && (
                <img
                  src={spotlightItem.imageUrl}
                  alt={spotlightItem.imageAlt}
                  width={800}
                  height={500}
                  fetchpriority="high"
                  decoding="async"
                  class="size-full object-cover opacity-80"
                />
              )
            }
            <div
              class="
                absolute inset-0 flex items-center justify-center
                bg-slate-950/35
              "
            >
              <a
                href={toSafeHref(spotlightItem.watchUrl)}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t("media-page.watch-youtube")}
                class="
                  flex size-16 items-center justify-center rounded-full
                  bg-primary text-white shadow-2xl transition-colors
                  hover:bg-primary-accent
                "
              >
                <Icon name="play_arrow" class="text-4xl" />
              </a>
            </div>
          </div>
        </div>
      </Card>
    )
  }

  <!-- Filterable Media Archive -->
  <section class="space-y-8">
    <div
      class="flex flex-wrap items-center justify-center gap-3"
      role="group"
      aria-label={t("media-page.filter-all")}
    >
      {
        [
          { filter: "all", label: t("media-page.filter-all"), pressed: true },
          {
            filter: "khutbah",
            label: t("media-page.filter-khutbah"),
            pressed: false,
          },
          {
            filter: "podcast",
            label: t("media-page.filter-podcast"),
            pressed: false,
          },
          {
            filter: "video",
            label: t("media-page.filter-video"),
            pressed: false,
          },
        ].map(({ filter, label, pressed }) => (
          <button
            type="button"
            data-media-filter={filter}
            aria-pressed={pressed ? "true" : "false"}
            class="
              cursor-pointer rounded-full border px-5 py-2 text-sm
              transition-colors
              focus-visible:ring-2 focus-visible:ring-secondary
              focus-visible:ring-offset-2 focus-visible:outline-none
              aria-pressed:border-secondary aria-pressed:bg-secondary
              aria-pressed:font-bold aria-pressed:text-white
              aria-pressed:shadow-sm
              aria-pressed:hover:border-secondary
              aria-pressed:hover:bg-secondary/90
              aria-[pressed=false]:border-slate-300
              aria-[pressed=false]:bg-white aria-[pressed=false]:font-semibold
              aria-[pressed=false]:text-slate-700
              aria-[pressed=false]:hover:border-slate-400
              aria-[pressed=false]:hover:bg-slate-100
              aria-[pressed=false]:hover:text-slate-900
              dark:aria-pressed:border-secondary dark:aria-pressed:bg-secondary
              dark:aria-pressed:hover:bg-secondary/90
              dark:aria-[pressed=false]:border-slate-700
              dark:aria-[pressed=false]:bg-slate-900
              dark:aria-[pressed=false]:text-slate-200
              dark:aria-[pressed=false]:hover:bg-slate-800
              dark:aria-[pressed=false]:hover:text-white
            "
          >
            {label}
          </button>
        ))
      }
    </div>

    <div class="
      grid grid-cols-1 gap-8
      md:grid-cols-2
      lg:grid-cols-3
    "
    >
      {
        mediaItems.map((item) => (
          <MediaArchiveCard
            item={item}
            listenOrWatchLabel={t("media-page.listen-or-watch")}
          />
        ))
      }
    </div>
  </section>
</div>

<script>
  import { initMediaFilters } from "./media-archive.controller";

  initMediaFilters();
  document.addEventListener("astro:after-swap", initMediaFilters);
</script>
