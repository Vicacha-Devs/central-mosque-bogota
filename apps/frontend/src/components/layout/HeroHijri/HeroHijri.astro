---
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import Icon from "@components/data/display/Icons/Icon.astro";
import { Image } from "astro:assets";

type Props = {
  /** Background image URL. */
  imageUrl: string;
  /** Accessible description for the background image. */
  imageAlt: string;
  /** Editorial hero headline. Falls back to `hijriDate` if omitted. */
  title?: string;
  /** Hijri date label shown in the metadata pill. */
  hijriDate: string;
  /** Gregorian date label shown next to the Hijri date. */
  currentDate: string;
  /** Supporting sentence shown under the headline. */
  phrase: string;
  /** Optional primary CTA label (e.g. Plan Your Visit). */
  primaryCtaLabel?: string;
  /** Optional primary CTA href. */
  primaryCtaHref?: string;
  /** Optional secondary CTA label (e.g. Prayer Times). */
  secondaryCtaLabel?: string;
  /** Optional secondary CTA href. */
  secondaryCtaHref?: string;
};

const {
  imageUrl,
  imageAlt,
  title,
  hijriDate,
  currentDate,
  phrase,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
} = Astro.props as Props;

const headingText = title ?? hijriDate;
---

<section
  class="
    relative flex min-h-[540px] w-full items-center overflow-hidden
    lg:min-h-[600px]
  "
>
  <Image
    src={imageUrl}
    alt={imageAlt}
    class="absolute inset-0 size-full object-cover"
    fetchpriority="high"
    loading="eager"
    layout="constrained"
    width={1600}
    height={900}
  />
  <div class="hero-overlay absolute inset-0"></div>
  <div
    class="
      relative mx-auto w-full max-w-5xl px-4 pt-16 pb-24 text-center
      sm:px-6 sm:pb-28
      lg:px-8 lg:pb-32
    "
  >
    <h1
      class="
        mx-auto mb-5 max-w-4xl text-4xl/tight font-extrabold tracking-tight
        text-white drop-shadow-lg
        sm:text-5xl/tight
        lg:text-6xl/tight
      "
    >
      {headingText}
    </h1>
    <Badge
      variant="outline"
      class="
        mx-auto mb-6 inline-flex flex-wrap items-center justify-center gap-x-3
        gap-y-1.5 rounded-full border border-white/20 bg-white/10 px-5 py-2
        text-sm text-white/95 backdrop-blur-sm
      "
    >
      <span class="font-semibold tracking-wide">{hijriDate}</span>
      <span class="text-white/60" aria-hidden="true">•</span>
      <time class="font-medium tabular-nums">{currentDate}</time>
    </Badge>
    <p
      class="
        mx-auto max-w-2xl text-lg/relaxed font-medium text-white/95
        lg:text-xl/relaxed
      "
    >
      {phrase}
    </p>
    {
      (primaryCtaHref || secondaryCtaHref) && (
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          {
            primaryCtaHref && primaryCtaLabel && (
              <Button
                href={primaryCtaHref}
                variant="primary"
                size="lg"
                class="rounded-full px-7 shadow-lg"
              >
                <span>{primaryCtaLabel}</span>
                <Icon name="arrow_forward" class="text-base rtl:-scale-x-100" />
              </Button>
            )
          }
          {
            secondaryCtaHref && secondaryCtaLabel && (
              /* TODO(https://github.com/starwind-ui/starwind-ui/issues/278): Starwind's outline variant uses
                 --outline (#212e80 in light mode) for focus-visible; keep focus treatments coordinated with
                 the dark hero surface until upstream contrast handling is resolved. */
              <Button
                href={secondaryCtaHref}
                variant="outline"
                size="lg"
                class="
                  rounded-full border-white/35 bg-white/10 px-7 text-white
                  backdrop-blur-sm
                  hover:bg-white/20 hover:text-white
                  focus-visible:border-white focus-visible:ring-white/50
                "
              >
                <Icon name="schedule" class="text-base" />
                <span>{secondaryCtaLabel}</span>
              </Button>
            )
          }
        </div>
      )
    }
  </div>
</section>
