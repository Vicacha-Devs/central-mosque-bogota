---
import { getCollection } from "astro:content";
import Footer from "@components/layout/Footer/Footer.astro";
import Header from "@components/layout/Header/Header.astro";
import UrgentAlertBanner from "@components/data/display/UrgentAlertBanner/UrgentAlertBanner.astro";
import { defaultLang, ui, type TLang } from "@i18n/ui";
import {
  buildAlternateLangHref,
  getLangFromUrl,
  useTranslations,
} from "@i18n/utils";
import { Font } from "astro:assets";
import { getLocalizedMocks } from "@utils/data.mocks";

import "@styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
};

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
  title: pageTitleProp,
  description: pageDescriptionProp,
  ogType = "website",
  ogImage: ogImageProp,
  jsonLd: jsonLdProp,
} = Astro.props as Props;

const defaultSiteTitle = t("seo.default-title");
const pageTitle = pageTitleProp
  ? `${pageTitleProp} | ${defaultSiteTitle}`
  : defaultSiteTitle;
const pageDescription = pageDescriptionProp ?? t("seo.default-description");

const supportedLangs = Object.keys(ui) as Array<TLang>;
const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const canonicalUrl = new URL(
  buildAlternateLangHref(Astro.url, lang, lang),
  siteOrigin,
).href;
const alternateLinks = supportedLangs.map((targetLang) => ({
  hreflang: targetLang,
  href: new URL(
    buildAlternateLangHref(Astro.url, targetLang, lang),
    siteOrigin,
  ).href,
}));
const xDefaultHref = new URL(
  buildAlternateLangHref(Astro.url, defaultLang, lang),
  siteOrigin,
).href;

const localizedMocks = getLocalizedMocks(lang);
const globalSettingEntries = await getCollection(
  "globalSetting",
  (entry) => entry.data.locale === lang,
);
const globalSetting = globalSettingEntries[0]?.data;

const dir = localizedMocks.dir;
const contactInfo = globalSetting?.contactInfo ?? localizedMocks.contactInfo;
const fastLinks = globalSetting?.fastLinks ?? localizedMocks.fastLinks;
const lemma = globalSetting?.lemma ?? localizedMocks.lemma;
const navLinks = globalSetting?.navLinks ?? localizedMocks.navLinks;
const rightsText = globalSetting?.rightsText ?? localizedMocks.rightsText;
const socialNetworkLinks =
  globalSetting?.socialNetworkLinks ?? localizedMocks.socialNetworkLinks;
const cspNonce = Astro.locals.cspNonce;
const hasHeroSlot = Astro.slots.has("hero");
const resolvedOgImage = ogImageProp
  ? new URL(ogImageProp, siteOrigin).href
  : undefined;
const structuredData = jsonLdProp ?? {
  "@context": "https://schema.org",
  "@type": "Mosque",
  "name": defaultSiteTitle,
  "description": pageDescription,
  "url": canonicalUrl,
  "inLanguage": lang,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Bogotá",
    "addressCountry": "CO",
  },
};
const serializedJsonLd = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<!doctype html>
<!-- ﷽ - In the name of Allah, the Most Gracious, the Most Merciful -->
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={defaultSiteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={lang} />
    <meta property="og:url" content={canonicalUrl} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta
      name="twitter:card"
      content={resolvedOgImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    <script type="application/ld+json" is:inline nonce={cspNonce}>
      {serializedJsonLd}
    </script>
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateLinks.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-symbols" preload />
    <Font cssVariable="--font-arabic" />
    <Font cssVariable="--font-arabic-serif" />

    <script is:inline nonce={cspNonce}>
      function applyResolvedTheme(resolved, setting) {
        document.documentElement.dataset.theme = resolved;
        document.documentElement.classList.toggle("dark", resolved === "dark");
        const meta = document.querySelector('meta[name="color-scheme"]');
        if (meta) {
          meta.setAttribute(
            "content",
            setting === "system" ? "light dark" : resolved,
          );
        }
      }

      function initTheme() {
        try {
          const stored =
            localStorage.getItem("colorTheme") || localStorage.getItem("theme");
          const setting =
            stored === "light" || stored === "dark" || stored === "system"
              ? stored
              : "system";

          const resolved =
            setting === "system"
              ? window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark"
              : setting;

          applyResolvedTheme(resolved, setting);
          localStorage.setItem("colorTheme", setting);
          localStorage.setItem("theme", setting);

          if (!window.__themeMqlBound) {
            window.__themeMqlBound = true;
            const mql = window.matchMedia("(prefers-color-scheme: dark)");
            const handleSystemChange = () => {
              const current =
                localStorage.getItem("colorTheme") ||
                localStorage.getItem("theme");
              if (current !== "system") return;
              applyResolvedTheme(mql.matches ? "dark" : "light", "system");
            };
            mql.addEventListener("change", handleSystemChange);
          }
        } catch {
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          applyResolvedTheme(prefersDark ? "dark" : "light", "system");
        }
      }

      initTheme();
      document.addEventListener("astro:after-swap", initTheme);
      document.addEventListener("theme:change", (e) => {
        const next = e?.detail?.theme;
        if (next === "dark" || next === "light") {
          applyResolvedTheme(next, next);
          try {
            localStorage.setItem("colorTheme", next);
            localStorage.setItem("theme", next);
          } catch {}
        }
      });
    </script>
  </head>
  <body
    class="
      bg-background font-sans text-foreground transition-colors duration-300
    "
  >
    <a
      href="#main-content"
      class="
        sr-only
        focus:not-sr-only focus:fixed focus:inset-s-4 focus:top-4 focus:z-100
        focus:rounded-xl focus:bg-secondary focus:px-4 focus:py-2.5
        focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg
      "
    >
      {t("common.skipToContent")}
    </a>
    <div class="sticky top-0 z-50">
      <UrgentAlertBanner lang={lang} />
      <Header lang={lang} navLinks={navLinks} />
    </div>
    <slot name="hero" />
    <main
      id="main-content"
      tabindex="-1"
      class:list={[
        `
          mx-auto mb-12 flex max-w-7xl flex-col gap-20 px-4 outline-none
          sm:px-6
          lg:mb-16 lg:px-8
        `,
        !hasHeroSlot && `
          mt-12
          lg:mt-16
        `,
      ]}
    >
      <slot />
    </main>
    <Footer
      lang={lang}
      lemma={lemma}
      contactInfo={contactInfo}
      rightsText={rightsText}
      socialNetworkLinks={socialNetworkLinks}
      fastLinks={fastLinks}
    />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
