# Copy to .env for local development. On Vercel, set these in Project Settings > Environment Variables.

# Strapi CMS (public URL of the deployed backend; required in production)
STRAPI_API_URL=http://127.0.0.1:1337
STRAPI_API_TOKEN=
PUBLIC_STRAPI_URL=http://127.0.0.1:1337

# Third-party APIs
ISLAMIC_API_KEY=
CLOUDINARY_CLOUD_NAME=

# Set to "true" on Vercel so /api/submissions reads the client IP from x-forwarded-for
TRUST_PROXY=false
# Local/CI only: accept form submissions when Strapi is unreachable
ALLOW_OFFLINE_MOCK_SUBMISSIONS=false
