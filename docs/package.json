    "typedoc": "node ./scripts/sync-typedoc.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "0.34.4",
    "astro": "5.18.2",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "typedoc": "0.28.7",
    "typedoc-plugin-markdown": "4.7.0",
    "typescript": "^5.7.2"
  }
}
