{
  "name": "@central-mosque-bogota/docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bilingual (EN/ES) Developer Handbook, Onboarding & Verification Portal powered by Astro Starlight, Pele, and TypeDoc",
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "node ./scripts/sync-typedoc.ts && astro build",
