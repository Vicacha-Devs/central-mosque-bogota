{
  "kind": "collectionType",
  "collectionName": "media_highlights",
  "info": {
    "singularName": "media-highlight",
    "pluralName": "media-highlights",
    "displayName": "Media Highlight & Khutbah",
    "description": "Multi-language Friday Khutbah sermons, podcasts, YouTube videos, audio recitations, and live broadcasts"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "type": {
      "type": "enumeration",
      "enum": ["video", "audio", "podcast", "khutbah", "lecture", "live"],
      "default": "video",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "provider": {
      "type": "enumeration",
      "enum": [
        "youtube",
        "spotify",
        "apple_podcasts",
        "vimeo",
        "soundcloud",
        "direct",
        "upload"
      ],
      "default": "youtube",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "externalId": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "embedUrl": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "seriesSlug": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "duration": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "publishedAtLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hijriDate": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "href": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "imageUrl": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "imageAlt": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "audioFile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["audios"],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "transcriptPdf": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["files"],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "speaker": {
      "type": "string",
      "default": "Sheikh Ahmad",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "spokenLanguages": {
      "type": "json",
      "default": ["ar", "es"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "languageTracks": {
      "type": "json",
      "default": [],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "chapters": {
      "type": "json",
      "default": [],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isLive": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
