{
  "kind": "singleType",
  "collectionName": "islam_faith_pages",
  "info": {
    "singularName": "islam-faith-page",
    "pluralName": "islam-faith-pages",
    "displayName": "Islam & Faith Page",
    "description": "Discover Islam page content, Shahada, Five Pillars, and introductory guides"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "heroTitle": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroSubtitle": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "introText": {
      "type": "customField",
      "customField": "plugin::tiptap-editor.RichText",
      "options": {
        "preset": "editorial"
      },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "shahadaArabic": {
      "type": "string",
      "default": "أَشْهَدُ أَنْ لَا إِلَٰهَ إِلَّا ٱللَّٰهُ وَأَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ ٱللَّٰهِ",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "shahadaTransliteration": {
      "type": "string",
      "default": "Ash-hadu an la ilaha illa Allah, wa ash-hadu anna Muhammadan Rasulu Allah",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "shahadaTranslation": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "fivePillars": {
      "type": "component",
      "repeatable": true,
      "component": "page.pillar-card",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
