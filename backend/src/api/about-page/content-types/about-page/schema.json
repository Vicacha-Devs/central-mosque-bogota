{
  "kind": "singleType",
  "collectionName": "about_pages",
  "info": {
    "singularName": "about-page",
    "pluralName": "about-pages",
    "displayName": "About Page",
    "description": "About Us page content: history timeline, mission/vision, and architectural heritage"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "heroTitle": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroSubtitle": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroImageUrl": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "missionTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "missionBody": {
      "type": "customField",
      "customField": "plugin::tiptap-editor.RichText",
      "options": {
        "preset": "standard"
      },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "visionTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "visionBody": {
      "type": "customField",
      "customField": "plugin::tiptap-editor.RichText",
      "options": {
        "preset": "standard"
      },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "historyTimeline": {
      "type": "component",
      "repeatable": true,
      "component": "page.timeline-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "architectureTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "architectureDescription": {
      "type": "customField",
      "customField": "plugin::tiptap-editor.RichText",
      "options": {
        "preset": "editorial"
      },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
