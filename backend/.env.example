# Server (MUST bind to 127.0.0.1 in local dev/test)
HOST=127.0.0.1
PORT=1337
PUBLIC_URL=http://127.0.0.1:1337
FRONTEND_URL=http://127.0.0.1:4321
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Security Secrets (Generate via `openssl rand -base64 32` in production)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
PREVIEW_SECRET=
PREVIEW_API_TOKEN=
STRAPI_ENV_LABEL=development


# Database (Dual-mode: 'sqlite' for local dev, 'postgres' for staging/prod)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=central_mosque_strapi
DATABASE_USERNAME=mosque_app_user
DATABASE_PASSWORD=
DATABASE_SSL=false

# Cloudinary CDN (@strapi/provider-upload-cloudinary)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_FOLDER=central-mosque-bogota

# Caching (strapi-cache)
CACHE_STRATEGY=memory
CACHE_TTL=3600000

# Typesense Search (@juadariasmar/strapi-plugin-typesense)
TYPESENSE_API_KEY=
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# SMTP & Transactional Email (@strapi/provider-email-nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_DEFAULT_FROM=no-reply@mezquitabogota.org
EMAIL_DEFAULT_REPLY_TO=info@mezquitabogota.org
EMAIL_ADMIN_NOTIFICATION_TO=info@mezquitabogota.org

# Public Form Protection (Rate Limiting & Optional Cloudflare Turnstile)
PUBLIC_FORM_RATE_LIMIT_MAX=5
PUBLIC_FORM_RATE_LIMIT_WINDOW_MS=600000
TURNSTILE_SECRET_KEY=



